---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/global.css';

const {
  title = 'RGballet — балетная студия',
  description = 'Балетная студия RGballet: профессиональная танцевальная подготовка для детей.',
} = Astro.props;

const faviconPath = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.ico`;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href={faviconPath} type="image/x-icon" />
    <title>{title}</title>
  </head>
  <body>
    <div class="page-wrapper">
      <slot />
    </div>
  </body>
</html>
