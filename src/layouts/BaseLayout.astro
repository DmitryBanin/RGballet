---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/global.css';
import CookieBanner from '../components/CookieBanner.astro';

const {
  title = 'RGballet — балетная студия',
  description = 'Балетная студия RGballet: профессиональная танцевальная подготовка для детей.',
} = Astro.props;

const faviconPath = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.ico`;

// Запрещаем индексацию по умолчанию.
// Для публичного сайта установить SEO_NOINDEX=false.
const noindex = import.meta.env.SEO_NOINDEX === 'true';

const robotsContent = noindex
  ? 'noindex, follow'
  : 'index, follow';
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={robotsContent} />
    <link rel="icon" href={faviconPath} type="image/x-icon" />
    <title>{title}</title>
  </head>
  <body>
    <div class="page-wrapper">
      <slot />
    </div>
    <CookieBanner />
  </body>
</html>
