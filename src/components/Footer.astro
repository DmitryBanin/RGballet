---
import Reviews from './Reviews.astro';
import Contacts from './Contacts.astro';
// import QuestionForm from './QuestionForm.astro';
import Copyright from './Copyright.astro';

const privacyPolicyPath = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/privacy-policy/`;
---

<footer class="site-footer">
  <div class="footer-panel">
    <Reviews />
    <div class="footer-divider" aria-hidden="true"></div>
    <Contacts />
    <!-- <div class="footer-divider" aria-hidden="true"></div>
    <QuestionForm /> -->
    <div class="footer-legal">
      <a href={privacyPolicyPath}>Политика в отношении обработки персональных данных</a>
      <Copyright />
    </div>
  </div>
</footer>

<style is:global>
  .site-footer {
    min-height: 524px;
    margin-top: var(--footer-space);
    padding: 50px 40px 0;
    background: var(--color-accent-secondary-20);
  }

  .footer-panel {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    width: min(100%, var(--container-max-width));
    min-height: 471px;
    margin-inline: auto;
    padding: 30px 30px 15px;
    column-gap: 77px;
    background: var(--color-surface-primary);
    border-radius: 30px 30px 0 0;
  }

  .footer-panel > :is(.reviews, .contacts, .question-form) {
    min-width: 0;
    flex: 1 1 0;
  }

  @media (width >= 1920px) {
    .footer-panel:has(> .question-form) > .reviews {
      flex-grow: 539;
    }

    .footer-panel:has(> .question-form) > .contacts {
      flex-grow: 418;
    }

    .footer-panel:has(> .question-form) > .question-form {
      flex-grow: 513;
    }
  }

  .site-footer h2,
  .site-footer h3,
  .site-footer p {
    margin: 0;
  }

  .site-footer h2 {
    font-family: 'Corvetta', 'Cormorant Garamond', serif;
    font-weight: 400;
  }

  .reviews {
    min-height: 353px;
  }

  .reviews-heading {
    position: relative;
    height: 80px;
  }

  .reviews-heading h2,
  .contacts h2 {
    color: var(--color-accent-primary);
    font-size: clamp(34px, 2.083vw, 40px);
    line-height: clamp(68px, 4.167vw, 80px);
  }

  .reviews-all {
    position: absolute;
    top: 34px;
    right: 0;
    color: var(--color-accent-primary);
    font-size: 16px;
    line-height: 24px;
    text-decoration: underline;
  }

  .review {
    position: relative;
    margin-top: 24px;
  }

  .review h3 {
    font-size: 24px;
    font-weight: 600;
    line-height: 34px;
  }

  .review time {
    display: block;
    font-size: 18px;
    line-height: 28px;
    opacity: 0.5;
  }

  .review p {
    margin-top: 12px;
    font-size: 18px;
    line-height: 28px;
  }

  .review-text {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .review-text.is-expanded {
    display: block;
  }

  .review-more {
    display: block;
    padding: 0;
    margin: 4px 0 0 auto;
    color: var(--color-accent-primary);
    background: transparent;
    border: 0;
    font-size: 14px;
    line-height: 20px;
    text-decoration: underline;
    cursor: pointer;
  }

  .review-navigation {
    display: flex;
    margin-top: 28px;
    align-items: center;
    justify-content: flex-end;
    gap: 50px;
  }

  .review-dots {
    display: flex;
    gap: 6px;
  }

  .review-dot {
    width: 16px;
    height: 16px;
    padding: 0;
    background: transparent;
    border: 2px solid var(--color-accent-primary);
    border-radius: 50%;
    cursor: pointer;
  }

  .review-dots .active {
    background: var(--color-accent-primary);
  }

  .review-arrows {
    display: flex;
    gap: 20px;
  }

  .review-arrow {
    display: grid;
    width: 30px;
    height: 30px;
    padding: 0;
    background: transparent;
    border: 0;
    cursor: pointer;
    place-items: center;
  }

  .review-arrows img {
    width: 30px;
    height: 30px;
  }

  .review-prev img {
    transform: scaleX(-1);
  }

  .review-arrow:disabled {
    opacity: 0.5;
    cursor: default;
  }

  .footer-divider {
    width: 1px;
    min-height: 368px;
    flex: 0 0 1px;
    background: var(--color-text-primary);
    opacity: 0.15;
  }

  .footer-divider:not(:has(+ .contacts, + .question-form)) {
    display: none;
  }

  .contacts {
    height: 353px;
    container-type: inline-size;
  }

  .contacts h2 {
    height: 79px;
  }

  .contact-list {
    display: flex;
    margin-top: 19px;
    flex-direction: column;
    gap: 19px;
  }

  .contact {
    display: flex;
    min-height: 30px;
    align-items: center;
    gap: 25px;
    font-size: 20px;
    line-height: 30px;
    text-decoration: none;
  }

  .contact-phone {
    gap: 20px;
  }

  .contact-phone strong {
    font-size: 30px;
    line-height: 40px;
  }

  .contact-address {
    min-width: 0;
    flex: 1;
    white-space: normal;
  }

  .contact-address-main {
    white-space: nowrap;
  }

  .contact-address-floor::before {
    content: ' ';
  }

  .contact-address.is-inline-wrap .contact-address-main {
    white-space: normal;
  }

  .contact-address.is-inline-wrap .contact-address-break {
    display: none;
  }

  .contact-icon {
    display: grid;
    width: 30px;
    height: 30px;
    flex: 0 0 30px;
    place-items: center;
  }

  .contact-icon img {
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: 100%;
  }

  .footer-socials {
    display: flex;
    margin-top: 67px;
    gap: 12px;
  }

  .footer-socials a,
  .footer-socials img {
    width: 50px;
    height: 50px;
  }

  .question-form {
    min-height: 343px;
    container-type: inline-size;
  }

  .question-heading {
    display: flex;
    height: 136px;
    flex-direction: column;
    gap: 20px;
  }

  .question-heading h2 {
    height: 58px;
    font-size: clamp(18px, 8.246cqi, 40px);
    line-height: clamp(68px, 4.167vw, 80px);
    white-space: nowrap;
  }

  .question-heading p {
    color: var(--color-accent-primary);
    font-size: 30px;
    line-height: 40px;
  }

  .site-footer form {
    display: flex;
    width: 469px;
    margin-top: 20px;
    flex-direction: column;
    gap: 8px;
  }

  .site-footer .form-field,
  .site-footer .form-field input,
  .site-footer .form-field textarea {
    display: block;
    width: 100%;
  }

  .site-footer .form-field input,
  .site-footer .form-field textarea {
    padding: 12px 24px;
    color: var(--color-text-primary);
    background: var(--color-surface-primary);
    border: 1px solid var(--color-accent-primary);
    border-radius: 30px;
    font-size: 18px;
    font-weight: 400;
    line-height: 25px;
  }

  .site-footer .form-field input {
    height: 50px;
  }

  .site-footer .form-field textarea {
    height: 104px;
    font-family: inherit;
    resize: vertical;
  }

  .site-footer .form-field input:hover,
  .site-footer .form-field input:focus,
  .site-footer .form-field textarea:hover,
  .site-footer .form-field textarea:focus {
    border: 2px solid var(--color-accent-primary);
    outline: none;
  }

  .site-footer .form-field input::placeholder,
  .site-footer .form-field textarea::placeholder {
    color: rgb(35 35 35 / 30%);
    opacity: 1;
  }

  .site-footer .form-action {
    position: relative;
    width: 100%;
    margin-top: 12px;
  }

  .site-footer .form-consent {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 12px;
    line-height: 17px;
    cursor: pointer;
  }

  .site-footer .form-consent input {
    width: 24px;
    height: 24px;
    flex: 0 0 24px;
    margin: 0;
    appearance: none;
    background: var(--color-surface-primary) center / 14.1767px 10px no-repeat;
    border: 1px solid var(--color-accent-primary);
    border-radius: 6px;
    cursor: pointer;
  }

  .site-footer .form-consent input:checked {
    background-image: var(--form-checkbox-image);
  }

  .site-footer .form-consent input:hover,
  .site-footer .form-consent input:focus {
    border: 2px solid var(--color-accent-primary);
    outline: none;
  }

  .site-footer .form-consent span {
    min-width: 0;
  }

  .site-footer .form-consent a {
    color: var(--color-accent-primary);
    text-underline-offset: 2px;
  }

  .site-footer .demo-status {
    position: absolute;
    inset: 0;
    display: grid;
    min-height: 100%;
    padding: 6px 16px;
    color: var(--color-accent-primary);
    background: var(--color-surface-primary);
    border: 1px solid var(--color-accent-primary);
    border-radius: 30px;
    font-size: 14px;
    line-height: 19px;
    text-align: center;
    place-items: center;
  }

  .site-footer .demo-status[hidden] {
    display: none;
  }

  .footer-legal {
    display: flex;
    flex: 0 0 100%;
    margin-top: 80px;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    line-height: 18px;
    text-align: center;
  }

  .footer-legal a {
    color: var(--color-accent-primary);
    text-underline-offset: 3px;
  }

  .site-footer .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (1200px <= width < 1920px) {
    .footer-panel {
      padding-inline: 24px;
      column-gap: 30px;
    }

    .footer-panel:has(> .question-form) > .reviews {
      flex-grow: 1.15;
    }

    .footer-panel:has(> .question-form) > .contacts {
      flex-grow: 0.9;
    }

    .footer-panel:has(> .question-form) > .question-form {
      flex-grow: 1.1;
    }

    .site-footer form {
      width: 100%;
    }

    .contact-phone strong {
      font-size: 24px;
    }
  }

  @media (768px <= width < 1236px) {
    .site-footer {
      min-height: auto;
      margin-top: var(--footer-space);
      padding: 40px var(--page-gutter);
    }

    .footer-panel {
      flex-wrap: wrap;
      min-height: auto;
      padding: 30px;
      gap: 75px clamp(12px, 2.948vw, 37.5px);
      border-radius: 30px;
    }

    .footer-divider {
      display: none;
    }

    .reviews + .footer-divider:has(+ .contacts) {
      display: block;
    }

    .footer-panel > .question-form {
      flex: 0 0 100%;
    }

    .footer-panel:has(> .question-form) > :is(.reviews, .contacts) {
      flex-grow: 1;
    }

    .site-footer form {
      width: min(100%, 600px);
    }

    .contact-phone strong {
      font-size: 24px;
    }

    .footer-legal {
      margin-top: 0;
      justify-content: center;
    }
  }

  @media (width >= 768px) {
    .contact-address {
      font-size: 20px;
    }

  }

  @media (width < 768px) {
    .site-footer {
      min-height: auto;
      margin-top: var(--footer-space);
      padding: 28px 20px 0;
    }

    .footer-panel {
      display: block;
      width: 320px;
      max-width: 100%;
      min-height: auto;
      padding: 30px 16px 48px;
      border-radius: 30px 30px 0 0;
    }

    .reviews {
      min-height: 349px;
    }

    .reviews-heading {
      height: 107px;
    }

    .reviews-heading h2,
    .contacts h2 {
      height: 67px;
      max-width: 100%;
      font-size: 30px;
      line-height: clamp(52px, 15vw, 60px);
    }

    .reviews-all {
      top: 67px;
      right: auto;
      left: 0;
      font-size: 16px;
    }

    .review {
      margin-top: 0;
    }

    .review h3 {
      font-size: 24px;
      line-height: 34px;
    }

    .review time {
      font-size: 18px;
      line-height: 28px;
    }

    .review p {
      margin-top: 12px;
      font-size: 14px;
      line-height: 22px;
    }

    .review-more {
      font-size: 12px;
    }

    .review-navigation {
      margin-top: 20px;
      justify-content: center;
    }

    .review-arrows {
      display: none;
    }

    .footer-divider {
      width: 288px;
      max-width: 100%;
      height: 1px;
      min-height: 1px;
      margin-block: 30px 29px;
    }

    .contacts {
      height: 252px;
    }

    .contacts h2 {
      height: 63px;
    }

    .contact-list {
      margin-top: 19px;
      gap: 14px;
    }

    .contact {
      min-height: 24px;
      gap: 16px;
      font-size: 14px;
      line-height: 22px;
    }

    .contact-phone {
      gap: 16px;
    }

    .contact-phone strong {
      font-size: 24px;
      line-height: 34px;
    }

    .contact-icon {
      width: 24px;
      height: 24px;
      flex-basis: 24px;
    }

    .footer-socials {
      margin-top: 30px;
      gap: 12px;
    }

    .footer-socials a,
    .footer-socials img {
      width: 30px;
      height: 30px;
    }

    .question-form {
      min-height: 293px;
    }

    .question-heading {
      height: 105px;
      gap: 10px;
    }

    .question-heading h2 {
      height: 52px;
      max-width: 100%;
      line-height: clamp(48px, 15vw, 60px);
    }

    .question-heading p {
      font-size: 22px;
      line-height: 32px;
    }

    .site-footer form {
      width: 288px;
      max-width: 100%;
      margin-top: 20px;
      gap: 8px;
    }

    .site-footer .form-field input,
    .site-footer .form-field textarea {
      font-size: 14px;
      line-height: 19px;
    }

    .site-footer .form-field input {
      height: 43px;
      padding: 12px 24px;
    }

    .site-footer .form-field textarea {
      height: 86px;
    }

    .site-footer .form-action {
      margin-top: 12px;
    }

    .site-footer .demo-status {
      font-size: 12px;
      line-height: 16px;
    }

    .footer-legal {
      width: 100%;
      margin-top: 50px;
      gap: 4px;
      font-size: 10px;
      line-height: 12px;
    }
  }
</style>
