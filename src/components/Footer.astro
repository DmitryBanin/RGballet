---
import { contacts } from '../config/contacts.js';
import GradientButton from './GradientButton.astro';

const assetPath = `${import.meta.env.BASE_URL}/images`;
---

<footer class="site-footer">
  <div class="footer-panel">
    <section class="reviews" id="reviews" aria-labelledby="reviews-title">
      <div class="reviews-heading">
        <h2 id="reviews-title">Отзывы</h2>
        <span class="reviews-all">Смотреть все отзывы</span>
      </div>

      <article class="review">
        <h3>Ирина Солохо</h3>
        <time datetime="2026-06-21">21.06.2026</time>
        <p>
          Дочка с огромным удовольствием ходит на занятия, и мы видим, как она развивается. Отношение к детям просто
          замечательное: доброжелательная атмосфера, поддержка и поощрение даже самых маленьких успехов...
        </p>
        <span class="review-more">Читать полностью</span>
      </article>

      <div class="review-navigation" aria-hidden="true">
        <div class="review-dots">
          <span class="active"></span><span></span><span></span><span></span><span></span>
        </div>
        <div class="review-arrows">
          <img class="review-prev" src={`${assetPath}/students-arrow.svg`} alt="" width="30" height="30" />
          <img src={`${assetPath}/students-arrow.svg`} alt="" width="30" height="30" />
        </div>
      </div>
    </section>

    <div class="footer-divider" aria-hidden="true"></div>

    <section class="contacts" id="contacts" aria-labelledby="contacts-title">
      <h2 id="contacts-title">Контакты</h2>

      <div class="contact-list">
        <a class="contact contact-phone" href={contacts.phone.href}>
          <span class="contact-icon"><img src={`${assetPath}/contact-phone.svg`} alt="" /></span>
          <strong>{contacts.phone.display}</strong>
        </a>
        <a
          class="contact"
          href={contacts.map.desktop}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Открыть адрес в Яндекс Картах"
          data-map-link
          data-android-map={contacts.map.android}
          data-ios-map={contacts.map.ios}
        >
          <span class="contact-icon"><img src={`${assetPath}/contact-location.svg`} alt="" /></span>
          <span>{contacts.address}</span>
        </a>
        <a class="contact" href={contacts.email.href}>
          <span class="contact-icon"><img src={`${assetPath}/contact-mail.svg`} alt="" /></span>
          <span>{contacts.email.display}</span>
        </a>
      </div>

      <div class="footer-socials" aria-label="Социальные сети">
        <a href={contacts.telegram} aria-label="Открыть Telegram">
          <img src={`${assetPath}/social-telegram.png`} alt="" width="50" height="50" />
        </a>
        <a href={contacts.max} aria-label="Открыть MAX">
          <img src={`${assetPath}/social-MAX.svg`} alt="" width="50" height="50" />
        </a>
      </div>
    </section>

    <div class="footer-divider" aria-hidden="true"></div>

    <section class="question-form" aria-labelledby="question-title">
      <div class="question-heading">
        <h2 id="question-title">Остались вопросы?</h2>
        <p>Мы с радостью ответим!</p>
      </div>

      <form aria-describedby="form-disabled-note">
        <span class="visually-hidden" id="form-disabled-note">Отправка формы пока не подключена</span>
        <label>
          <span class="visually-hidden">Ваше имя</span>
          <input type="text" name="name" placeholder="Ваше имя" autocomplete="name" readonly />
        </label>
        <label>
          <span class="visually-hidden">Телефон</span>
          <input type="tel" name="phone" placeholder="Телефон" autocomplete="tel" readonly />
        </label>
        <div class="form-action">
          <GradientButton label="Отправить" fullWidth={true} disabled={true} />
        </div>
      </form>
    </section>

    <p class="copyright">© RG BALLET, 2026</p>
  </div>
</footer>

<script>
  const mapLink = document.querySelector('[data-map-link]');

  if (mapLink instanceof HTMLAnchorElement) {
    const isAndroid = /Android/i.test(navigator.userAgent);
    const isIOS =
      /iPad|iPhone|iPod/i.test(navigator.userAgent) ||
      (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);

    if (isAndroid && mapLink.dataset.androidMap) {
      mapLink.href = mapLink.dataset.androidMap;
      mapLink.removeAttribute('target');
      mapLink.removeAttribute('rel');
      mapLink.setAttribute('aria-label', 'Открыть адрес в приложении карт');
    } else if (isIOS && mapLink.dataset.iosMap) {
      mapLink.href = mapLink.dataset.iosMap;
      mapLink.removeAttribute('target');
      mapLink.removeAttribute('rel');
      mapLink.setAttribute('aria-label', 'Открыть адрес в Apple Maps');
    }
  }
</script>

<style>
  .site-footer {
    height: 524px;
    margin-top: 100px;
    padding: 50px 40px 0;
    background: var(--color-accent-secondary-20);
  }

  .footer-panel {
    position: relative;
    display: grid;
    width: min(100%, var(--container-max-width));
    height: 471px;
    margin-inline: auto;
    padding: 30px;
    grid-template-columns: 539px 1px 418px 1px 513px;
    column-gap: 77px;
    background: var(--color-surface-primary);
    border-radius: 30px 30px 0 0;
  }

  h2,
  h3,
  p {
    margin: 0;
  }

  h2 {
    font-family: 'Corvetta', 'Cormorant Garamond', serif;
    font-weight: 400;
  }

  .reviews {
    height: 353px;
  }

  .reviews-heading {
    position: relative;
    height: 80px;
  }

  .reviews-heading h2,
  .contacts h2 {
    color: var(--color-accent-primary);
    font-size: 40px;
    line-height: 80px;
  }

  .reviews-all {
    position: absolute;
    top: 34px;
    right: 0;
    color: var(--color-accent-primary);
    font-size: 16px;
    line-height: 24px;
    text-decoration: underline;
  }

  .review {
    position: relative;
    margin-top: 24px;
  }

  .review h3 {
    font-size: 24px;
    font-weight: 600;
    line-height: 34px;
  }

  .review time {
    display: block;
    font-size: 18px;
    line-height: 28px;
    opacity: 0.5;
  }

  .review p {
    margin-top: 12px;
    font-size: 18px;
    line-height: 28px;
  }

  .review-more {
    position: absolute;
    right: 0;
    bottom: 0;
    color: var(--color-accent-primary);
    font-size: 14px;
    line-height: 20px;
  }

  .review-navigation {
    display: flex;
    margin-top: 40px;
    align-items: center;
    justify-content: flex-end;
    gap: 50px;
  }

  .review-dots {
    display: flex;
    gap: 6px;
  }

  .review-dots span {
    width: 16px;
    height: 16px;
    border: 2px solid var(--color-accent-primary);
    border-radius: 50%;
  }

  .review-dots .active {
    background: var(--color-accent-primary);
  }

  .review-arrows {
    display: flex;
    gap: 20px;
  }

  .review-arrows img {
    width: 30px;
    height: 30px;
  }

  .review-prev {
    opacity: 0.5;
    transform: scaleX(-1);
  }

  .footer-divider {
    width: 1px;
    height: 368px;
    background: var(--color-text-primary);
    opacity: 0.15;
  }

  .contacts {
    height: 353px;
  }

  .contacts h2 {
    height: 79px;
  }

  .contact-list {
    display: flex;
    margin-top: 19px;
    flex-direction: column;
    gap: 19px;
  }

  .contact {
    display: flex;
    min-height: 30px;
    align-items: center;
    gap: 25px;
    font-size: 20px;
    line-height: 30px;
    text-decoration: none;
  }

  .contact-phone {
    gap: 20px;
  }

  .contact-phone strong {
    font-size: 30px;
    line-height: 40px;
  }

  .contact-icon {
    display: grid;
    width: 30px;
    height: 30px;
    flex: 0 0 30px;
    place-items: center;
  }

  .contact-icon img {
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: 100%;
  }

  .footer-socials {
    display: flex;
    margin-top: 67px;
    gap: 12px;
  }

  .footer-socials a,
  .footer-socials img {
    width: 50px;
    height: 50px;
  }

  .question-form {
    height: 343px;
  }

  .question-heading {
    display: flex;
    height: 136px;
    flex-direction: column;
    gap: 20px;
  }

  .question-heading h2 {
    height: 58px;
    font-size: 40px;
    line-height: 80px;
  }

  .question-heading p {
    color: var(--color-accent-primary);
    font-size: 30px;
    line-height: 40px;
  }

  form {
    display: flex;
    width: 469px;
    margin-top: 20px;
    flex-direction: column;
    gap: 8px;
  }

  label,
  input {
    display: block;
    width: 100%;
  }

  input {
    height: 50px;
    padding: 12px 24px;
    color: var(--color-text-primary);
    background: var(--color-surface-primary);
    border: 1px solid var(--color-accent-primary);
    border-radius: 30px;
    font-size: 18px;
    font-weight: 400;
    line-height: 25px;
  }

  input::placeholder {
    color: rgb(35 35 35 / 30%);
    opacity: 1;
  }

  .form-action {
    width: 100%;
    margin-top: 12px;
  }

  .copyright {
    position: absolute;
    bottom: 17px;
    left: 50%;
    font-size: 14px;
    line-height: 18px;
    transform: translateX(-50%);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 1799px) and (min-width: 1200px) {
    .footer-panel {
      padding-inline: 24px;
      grid-template-columns: 1.15fr 1px 0.9fr 1px 1.1fr;
      column-gap: 30px;
    }

    form {
      width: 100%;
    }

    .contact-phone strong {
      font-size: 24px;
    }
  }

  @media (max-width: 1199px) and (min-width: 768px) {
    .site-footer {
      height: auto;
      margin-top: 90px;
      padding: 40px var(--page-gutter);
    }

    .footer-panel {
      display: grid;
      height: auto;
      padding: 30px;
      grid-template-columns: 1fr 1fr;
      gap: 50px;
      border-radius: 30px;
    }

    .footer-divider {
      display: none;
    }

    .question-form {
      grid-column: 1 / -1;
    }

    form {
      width: min(100%, 600px);
    }

    .copyright {
      position: static;
      grid-column: 1 / -1;
      transform: none;
      text-align: center;
    }
  }

  @media (max-width: 767px) {
    .site-footer {
      height: 1138px;
      margin-top: 70px;
      padding: 28px 20px 0;
    }

    .footer-panel {
      display: block;
      width: 320px;
      max-width: 100%;
      height: 1110px;
      padding: 30px 16px 24px;
      border-radius: 30px 30px 0 0;
    }

    .reviews {
      height: 349px;
    }

    .reviews-heading {
      height: 107px;
    }

    .reviews-heading h2,
    .contacts h2 {
      height: 67px;
      font-size: 30px;
      line-height: 60px;
    }

    .reviews-all {
      top: 67px;
      right: auto;
      left: 0;
      font-size: 16px;
    }

    .review {
      margin-top: 0;
    }

    .review h3 {
      font-size: 24px;
      line-height: 34px;
    }

    .review time {
      font-size: 18px;
      line-height: 28px;
    }

    .review p {
      margin-top: 12px;
      font-size: 14px;
      line-height: 22px;
    }

    .review-more {
      bottom: 0;
      font-size: 12px;
    }

    .review-navigation {
      margin-top: 20px;
      justify-content: center;
    }

    .review-arrows {
      display: none;
    }

    .footer-divider {
      width: 288px;
      max-width: 100%;
      height: 1px;
      margin-block: 30px 29px;
    }

    .contacts {
      height: 252px;
    }

    .contacts h2 {
      height: 63px;
    }

    .contact-list {
      margin-top: 19px;
      gap: 14px;
    }

    .contact {
      min-height: 24px;
      gap: 16px;
      font-size: 14px;
      line-height: 22px;
    }

    .contact-phone {
      gap: 16px;
    }

    .contact-phone strong {
      font-size: 24px;
      line-height: 34px;
    }

    .contact-icon {
      width: 24px;
      height: 24px;
      flex-basis: 24px;
    }

    .footer-socials {
      margin-top: 30px;
      gap: 12px;
    }

    .footer-socials a,
    .footer-socials img {
      width: 30px;
      height: 30px;
    }

    .question-form {
      height: 293px;
    }

    .question-heading {
      height: 105px;
      gap: 10px;
    }

    .question-heading h2 {
      height: 52px;
      font-size: 25px;
      line-height: 60px;
    }

    .question-heading p {
      font-size: 22px;
      line-height: 32px;
    }

    form {
      width: 288px;
      max-width: 100%;
      margin-top: 20px;
      gap: 8px;
    }

    input {
      height: 43px;
      padding: 12px 24px;
      font-size: 14px;
      line-height: 19px;
    }

    .form-action {
      margin-top: 12px;
    }

    .copyright {
      bottom: 24px;
      font-size: 10px;
      line-height: 12px;
    }
  }
</style>
