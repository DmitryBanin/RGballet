---
import { contacts } from '../config/contacts.js';
import GradientButton from './GradientButton.astro';

const assetPath = `${import.meta.env.BASE_URL}/images`;

const comments = [
  // Здесь добавлять комментарии
  {
    name: 'Ирина Солоха',
    date: '21.06.2026',
    comment: 'Дочка с огромным удовольствием ходит на занятия, и мы видим, как она развивается. Отношение к детям просто замечательное: доброжелательная атмосфера, поддержка и поощрение даже самых маленьких успехов. Мы очень довольны выбором и с уверенностью рекомендуем эту танцевальную студию всем, кто хочет привить ребёнку любовь к танцам и развить его физические и творческие способности! Спасибо за ваш труд и заботу о наших детях!',
  },
  {
    name: 'Александр Фёдоров',
    date: '22.06.2026',
    comment: 'Наши девочки ходят уже более полугода к Елене и мы очень довольны. Очень грамотные преподаватели, наши девочки выросли прям на глазах в плане хореографии и растяжке. И самое главное самим девчонкам очень нравится. Всем родителям рекомендую👍👍👍',
  },
  {
    name: 'Elena Druzhinina',
    date: '21.06.2026',
    comment: 'Ценим за индивидуальный подход абсолютно к каждому ребёнку! Хореографы студии заинтересованы в результатах обучения, делают все возможное, чтобы дети хотели ходить на занятия и ощущать свои успехи.',
  },
  {
    name: 'Алексей Гончаров',
    date: '26.04.2026',
    comment: 'Если вы думаете отдать своего ребенка в танцы , советую Rg ballet. Отличная база, квалифицированные тренера, которые найдут подход к каждому ребенку. Ребенок в восторге и с удовольствием занимается',
  },
  {
    name: 'Анна Ц.',
    date: '01.01.2026',
    comment: 'Отличная балетная студия для детей! Хотим выразить огромную благодарность замечательной студии балета. Моя дочь занимается здесь уже пол года и мы видим потрясающие результаты. Самое главное для нас — это не только красивые позиции, но и гармоничное развитие. Благодаря грамотному и внимательному подходу педагогов, дочь стала невероятно гибкой, пластичной и грациозной. Уроки построены очень профессионально: разминка, растяжка, хореография — всё идет постепенно, без перегрузок, но с ощутимым прогрессом.Отдельное спасибо преподавателям за их доброе, но требовательное отношение к детям. Они умеют создать атмосферу настоящего искусства, где есть и дисциплина, и радость творчества. Дочь ходит на занятия с огромным удовольствием, а я как родитель вижу, как крепчает ее спинка, улучшается осанка и появляется уверенность в себе.Рекомендуем эту студию всем, кто хочет приобщить ребенка к прекрасному и подарить ему здоровье, грацию и хороший вкус!',
  },
];
---

<footer class="site-footer">
  <div class="footer-panel">
    <section class="reviews" id="reviews" aria-labelledby="reviews-title">
      <div class="reviews-heading">
        <h2 id="reviews-title">Отзывы</h2>
        <a class="reviews-all" href={contacts.map.reviews} target="_blank" rel="noopener noreferrer">
          Смотреть все отзывы
        </a>
      </div>

      {comments.map((comment, index) => (
        <article class="review" data-review-card hidden={index !== 0}>
          <h3>{comment.name}</h3>
          <time datetime={comment.date.split('.').reverse().join('-')}>{comment.date}</time>
          <p class="review-text" id={`review-text-${index + 1}`}>{comment.comment}</p>
          <button
            class="review-more"
            type="button"
            aria-expanded="false"
            aria-controls={`review-text-${index + 1}`}
            data-review-toggle
          >
            Читать полностью
          </button>
        </article>
      ))}

      <div class="review-navigation" aria-label="Навигация по отзывам">
        <div class="review-dots">
          {comments.map((_, index) => (
            <button
              class={index === 0 ? 'review-dot active' : 'review-dot'}
              type="button"
              aria-label={`Показать отзыв ${index + 1}`}
              aria-current={index === 0 ? 'true' : undefined}
              data-review-dot={index}
            ></button>
          ))}
        </div>
        <div class="review-arrows">
          <button class="review-arrow review-prev" type="button" aria-label="Предыдущий отзыв" data-review-prev disabled>
            <img src={`${assetPath}/arrow.svg`} alt="" width="30" height="30" />
          </button>
          <button
            class="review-arrow"
            type="button"
            aria-label="Следующий отзыв"
            data-review-next
            disabled={comments.length < 2}
          >
            <img src={`${assetPath}/arrow.svg`} alt="" width="30" height="30" />
          </button>
        </div>
      </div>
    </section>

    <div class="footer-divider" aria-hidden="true"></div>

    <section class="contacts" id="contacts" aria-labelledby="contacts-title">
      <h2 id="contacts-title">Контакты</h2>

      <div class="contact-list">
        <a class="contact contact-phone" href={contacts.phone.href}>
          <span class="contact-icon"><img src={`${assetPath}/contact-phone.svg`} alt="" /></span>
          <strong>{contacts.phone.display}</strong>
        </a>
        <a
          class="contact"
          href={contacts.map.desktop}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Открыть адрес в Яндекс Картах"
          data-map-link
          data-android-map={contacts.map.android}
          data-ios-map={contacts.map.ios}
        >
          <span class="contact-icon"><img src={`${assetPath}/contact-location.svg`} alt="" /></span>
          <span>{contacts.address}</span>
        </a>
        <a class="contact" href={contacts.email.href}>
          <span class="contact-icon"><img src={`${assetPath}/contact-mail.svg`} alt="" /></span>
          <span>{contacts.email.display}</span>
        </a>
      </div>

      <div class="footer-socials" aria-label="Социальные сети">
      <a href={contacts.vk} target="_blank" rel="noopener noreferrer" aria-label="Открыть VK в новой вкладке"
      >
        <img src={`${assetPath}/social-vk.svg`} alt="" width="50" height="50" />
      </a>
        <a href={contacts.max} target="_blank" rel="noopener noreferrer" aria-label="Открыть MAX в новой вкладке">
          <img src={`${assetPath}/social-MAX.svg`} alt="" width="50" height="50" />
        </a>
      </div>
    </section>

    <div class="footer-divider" aria-hidden="true"></div>

    <section class="question-form" aria-labelledby="question-title">
      <div class="question-heading">
        <h2 id="question-title">Остались вопросы?</h2>
        <p>Мы с радостью ответим!</p>
      </div>

      <form aria-describedby="form-disabled-note">
        <span class="visually-hidden" id="form-disabled-note">Отправка формы пока не подключена</span>
        <label>
          <span class="visually-hidden">Ваше имя</span>
          <input type="text" name="name" placeholder="Ваше имя" autocomplete="name" readonly />
        </label>
        <label>
          <span class="visually-hidden">Телефон</span>
          <input type="tel" name="phone" placeholder="Телефон" autocomplete="tel" readonly />
        </label>
        <div class="form-action">
          <GradientButton label="Отправить" fullWidth={true} disabled={true} />
        </div>
      </form>
    </section>

    <p class="copyright">© RG BALLET, 2026</p>
  </div>
</footer>

<script>
  const mapLink = document.querySelector('[data-map-link]');

  if (mapLink instanceof HTMLAnchorElement) {
    const isAndroid = /Android/i.test(navigator.userAgent);
    const isIOS =
      /iPad|iPhone|iPod/i.test(navigator.userAgent) ||
      (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);

    if (isAndroid && mapLink.dataset.androidMap) {
      mapLink.href = mapLink.dataset.androidMap;
      mapLink.removeAttribute('target');
      mapLink.removeAttribute('rel');
      mapLink.setAttribute('aria-label', 'Открыть адрес в приложении карт');
    } else if (isIOS && mapLink.dataset.iosMap) {
      mapLink.href = mapLink.dataset.iosMap;
      mapLink.removeAttribute('target');
      mapLink.removeAttribute('rel');
      mapLink.setAttribute('aria-label', 'Открыть адрес в Apple Maps');
    }
  }

  document.querySelectorAll('[data-review-toggle]').forEach((toggle) => {
    if (!(toggle instanceof HTMLButtonElement)) return;

    const textId = toggle.getAttribute('aria-controls');
    const reviewText = textId ? document.getElementById(textId) : null;

    if (!reviewText) return;

    toggle.addEventListener('click', () => {
      const isExpanded = toggle.getAttribute('aria-expanded') === 'true';

      toggle.setAttribute('aria-expanded', String(!isExpanded));
      toggle.textContent = isExpanded ? 'Читать полностью' : 'Свернуть';
      reviewText.classList.toggle('is-expanded', !isExpanded);
    });
  });

  const reviews = document.querySelector('.reviews');

  if (reviews instanceof HTMLElement) {
    const reviewCards = Array.from(reviews.querySelectorAll('[data-review-card]')).filter(
      (card): card is HTMLElement => card instanceof HTMLElement,
    );
    const reviewDots = Array.from(reviews.querySelectorAll('[data-review-dot]')).filter(
      (dot): dot is HTMLButtonElement => dot instanceof HTMLButtonElement,
    );
    const previousButton = reviews.querySelector('[data-review-prev]');
    const nextButton = reviews.querySelector('[data-review-next]');
    let activeReview = 0;

    const collapseReview = (card: HTMLElement) => {
      const toggle = card.querySelector('[data-review-toggle]');
      const reviewText = card.querySelector('.review-text');

      if (toggle instanceof HTMLButtonElement && reviewText instanceof HTMLElement) {
        toggle.setAttribute('aria-expanded', 'false');
        toggle.textContent = 'Читать полностью';
        reviewText.classList.remove('is-expanded');
      }
    };

    const showReview = (index: number) => {
      if (index < 0 || index >= reviewCards.length) return;

      reviewCards.forEach((card, cardIndex) => {
        if (cardIndex !== index) collapseReview(card);
        card.hidden = cardIndex !== index;
      });

      reviewDots.forEach((dot, dotIndex) => {
        const isActive = dotIndex === index;
        dot.classList.toggle('active', isActive);

        if (isActive) {
          dot.setAttribute('aria-current', 'true');
        } else {
          dot.removeAttribute('aria-current');
        }
      });

      activeReview = index;

      if (previousButton instanceof HTMLButtonElement) previousButton.disabled = activeReview === 0;
      if (nextButton instanceof HTMLButtonElement) nextButton.disabled = activeReview === reviewCards.length - 1;
    };

    reviewDots.forEach((dot, index) => dot.addEventListener('click', () => showReview(index)));

    if (previousButton instanceof HTMLButtonElement) {
      previousButton.addEventListener('click', () => showReview(activeReview - 1));
    }

    if (nextButton instanceof HTMLButtonElement) {
      nextButton.addEventListener('click', () => showReview(activeReview + 1));
    }
  }
</script>

<style>
  .site-footer {
    min-height: 524px;
    margin-top: 100px;
    padding: 50px 40px 0;
    background: var(--color-accent-secondary-20);
  }

  .footer-panel {
    position: relative;
    display: grid;
    width: min(100%, var(--container-max-width));
    min-height: 471px;
    margin-inline: auto;
    padding: 30px 30px 50px;
    grid-template-columns: 539px 1px 418px 1px 513px;
    column-gap: 77px;
    background: var(--color-surface-primary);
    border-radius: 30px 30px 0 0;
  }

  h2,
  h3,
  p {
    margin: 0;
  }

  h2 {
    font-family: 'Corvetta', 'Cormorant Garamond', serif;
    font-weight: 400;
  }

  .reviews {
    min-height: 353px;
  }

  .reviews-heading {
    position: relative;
    height: 80px;
  }

  .reviews-heading h2,
  .contacts h2 {
    color: var(--color-accent-primary);
    font-size: 40px;
    line-height: 80px;
  }

  .reviews-all {
    position: absolute;
    top: 34px;
    right: 0;
    color: var(--color-accent-primary);
    font-size: 16px;
    line-height: 24px;
    text-decoration: underline;
  }

  .review {
    position: relative;
    margin-top: 24px;
  }

  .review h3 {
    font-size: 24px;
    font-weight: 600;
    line-height: 34px;
  }

  .review time {
    display: block;
    font-size: 18px;
    line-height: 28px;
    opacity: 0.5;
  }

  .review p {
    margin-top: 12px;
    font-size: 18px;
    line-height: 28px;
  }

  .review-text {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .review-text.is-expanded {
    display: block;
  }

  .review-more {
    display: block;
    padding: 0;
    margin: 4px 0 0 auto;
    color: var(--color-accent-primary);
    background: transparent;
    border: 0;
    font-size: 14px;
    line-height: 20px;
    text-decoration: underline;
    cursor: pointer;
  }

  .review-navigation {
    display: flex;
    margin-top: 28px;
    align-items: center;
    justify-content: flex-end;
    gap: 50px;
  }

  .review-dots {
    display: flex;
    gap: 6px;
  }

  .review-dot {
    width: 16px;
    height: 16px;
    padding: 0;
    background: transparent;
    border: 2px solid var(--color-accent-primary);
    border-radius: 50%;
    cursor: pointer;
  }

  .review-dots .active {
    background: var(--color-accent-primary);
  }

  .review-arrows {
    display: flex;
    gap: 20px;
  }

  .review-arrow {
    display: grid;
    width: 30px;
    height: 30px;
    padding: 0;
    background: transparent;
    border: 0;
    cursor: pointer;
    place-items: center;
  }

  .review-arrows img {
    width: 30px;
    height: 30px;
  }

  .review-prev img {
    transform: scaleX(-1);
  }

  .review-arrow:disabled {
    opacity: 0.5;
    cursor: default;
  }

  .footer-divider {
    width: 1px;
    min-height: 368px;
    background: var(--color-text-primary);
    opacity: 0.15;
  }

  .contacts {
    height: 353px;
  }

  .contacts h2 {
    height: 79px;
  }

  .contact-list {
    display: flex;
    margin-top: 19px;
    flex-direction: column;
    gap: 19px;
  }

  .contact {
    display: flex;
    min-height: 30px;
    align-items: center;
    gap: 25px;
    font-size: 20px;
    line-height: 30px;
    text-decoration: none;
  }

  .contact-phone {
    gap: 20px;
  }

  .contact-phone strong {
    font-size: 30px;
    line-height: 40px;
  }

  .contact-icon {
    display: grid;
    width: 30px;
    height: 30px;
    flex: 0 0 30px;
    place-items: center;
  }

  .contact-icon img {
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: 100%;
  }

  .footer-socials {
    display: flex;
    margin-top: 67px;
    gap: 12px;
  }

  .footer-socials a,
  .footer-socials img {
    width: 50px;
    height: 50px;
  }

  .question-form {
    height: 343px;
  }

  .question-heading {
    display: flex;
    height: 136px;
    flex-direction: column;
    gap: 20px;
  }

  .question-heading h2 {
    height: 58px;
    font-size: 40px;
    line-height: 80px;
  }

  .question-heading p {
    color: var(--color-accent-primary);
    font-size: 30px;
    line-height: 40px;
  }

  form {
    display: flex;
    width: 469px;
    margin-top: 20px;
    flex-direction: column;
    gap: 8px;
  }

  label,
  input {
    display: block;
    width: 100%;
  }

  input {
    height: 50px;
    padding: 12px 24px;
    color: var(--color-text-primary);
    background: var(--color-surface-primary);
    border: 1px solid var(--color-accent-primary);
    border-radius: 30px;
    font-size: 18px;
    font-weight: 400;
    line-height: 25px;
  }

  input::placeholder {
    color: rgb(35 35 35 / 30%);
    opacity: 1;
  }

  .form-action {
    width: 100%;
    margin-top: 12px;
  }

  .copyright {
    position: absolute;
    bottom: 17px;
    left: 50%;
    font-size: 14px;
    line-height: 18px;
    transform: translateX(-50%);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 1919px) and (min-width: 1200px) {
    .footer-panel {
      padding-inline: 24px;
      grid-template-columns: 1.15fr 1px 0.9fr 1px 1.1fr;
      column-gap: 30px;
    }

    form {
      width: 100%;
    }

    .contact-phone strong {
      font-size: 24px;
    }
  }

  @media (max-width: 1199px) and (min-width: 768px) {
    .site-footer {
      min-height: auto;
      margin-top: 90px;
      padding: 40px var(--page-gutter);
    }

    .footer-panel {
      display: grid;
      min-height: auto;
      padding: 30px;
      grid-template-columns: 1fr 1fr;
      gap: 50px;
      border-radius: 30px;
    }

    .footer-divider {
      display: none;
    }

    .question-form {
      grid-column: 1 / -1;
    }

    form {
      width: min(100%, 600px);
    }

    .copyright {
      position: static;
      grid-column: 1 / -1;
      transform: none;
      text-align: center;
    }
  }

  @media (max-width: 767px) {
    .site-footer {
      min-height: 1138px;
      margin-top: 70px;
      padding: 28px 20px 0;
    }

    .footer-panel {
      display: block;
      width: 320px;
      max-width: 100%;
      min-height: 1110px;
      padding: 30px 16px 48px;
      border-radius: 30px 30px 0 0;
    }

    .reviews {
      min-height: 349px;
    }

    .reviews-heading {
      height: 107px;
    }

    .reviews-heading h2,
    .contacts h2 {
      height: 67px;
      font-size: 30px;
      line-height: 60px;
    }

    .reviews-all {
      top: 67px;
      right: auto;
      left: 0;
      font-size: 16px;
    }

    .review {
      margin-top: 0;
    }

    .review h3 {
      font-size: 24px;
      line-height: 34px;
    }

    .review time {
      font-size: 18px;
      line-height: 28px;
    }

    .review p {
      margin-top: 12px;
      font-size: 14px;
      line-height: 22px;
    }

    .review-more {
      font-size: 12px;
    }

    .review-navigation {
      margin-top: 20px;
      justify-content: center;
    }

    .review-arrows {
      display: none;
    }

    .footer-divider {
      width: 288px;
      max-width: 100%;
      height: 1px;
      min-height: 1px;
      margin-block: 30px 29px;
    }

    .contacts {
      height: 252px;
    }

    .contacts h2 {
      height: 63px;
    }

    .contact-list {
      margin-top: 19px;
      gap: 14px;
    }

    .contact {
      min-height: 24px;
      gap: 16px;
      font-size: 14px;
      line-height: 22px;
    }

    .contact-phone {
      gap: 16px;
    }

    .contact-phone strong {
      font-size: 24px;
      line-height: 34px;
    }

    .contact-icon {
      width: 24px;
      height: 24px;
      flex-basis: 24px;
    }

    .footer-socials {
      margin-top: 30px;
      gap: 12px;
    }

    .footer-socials a,
    .footer-socials img {
      width: 30px;
      height: 30px;
    }

    .question-form {
      height: 293px;
    }

    .question-heading {
      height: 105px;
      gap: 10px;
    }

    .question-heading h2 {
      height: 52px;
      font-size: 25px;
      line-height: 60px;
    }

    .question-heading p {
      font-size: 22px;
      line-height: 32px;
    }

    form {
      width: 288px;
      max-width: 100%;
      margin-top: 20px;
      gap: 8px;
    }

    input {
      height: 43px;
      padding: 12px 24px;
      font-size: 14px;
      line-height: 19px;
    }

    .form-action {
      margin-top: 12px;
    }

    .copyright {
      bottom: 24px;
      font-size: 10px;
      line-height: 12px;
    }
  }
</style>
