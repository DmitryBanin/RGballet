---
const assetPath = `${import.meta.env.BASE_URL}/images`;
const videoUrl = 'https://kinescope.io/embed/0NLFuty3QtSp6s61FWQp7K?autoplay=1';
---

<dialog class="video-modal" aria-label="Видео о студии RGballet" data-video-modal>
  <div class="video-player">
    <button class="video-close" type="button" aria-label="Закрыть видео" data-video-close>
      <img src={`${assetPath}/form-close.svg`} alt="" width="50" height="50" />
    </button>

    <iframe
      title="Видео о студии RGballet"
      data-video-frame
      data-src={videoUrl}
      allow="autoplay; fullscreen; picture-in-picture; encrypted-media; gyroscope; accelerometer; clipboard-write; screen-wake-lock"
      allowfullscreen
    ></iframe>
  </div>
</dialog>

<script>
  const modal = document.querySelector('[data-video-modal]');

  if (modal instanceof HTMLDialogElement) {
    const closeButton = modal.querySelector('[data-video-close]');
    const frame = modal.querySelector('[data-video-frame]');
    let previousFocus = null;

    const openModal = (trigger) => {
      if (modal.open || !(frame instanceof HTMLIFrameElement)) return;

      previousFocus = trigger;
      frame.src = frame.dataset.src ?? '';
      modal.showModal();
      document.body.classList.add('modal-open');

      requestAnimationFrame(() => {
        if (closeButton instanceof HTMLButtonElement) closeButton.focus();
      });
    };

    const closeModal = () => {
      if (modal.open) modal.close();
    };

    document.querySelectorAll('[data-video-open]').forEach((trigger) => {
      trigger.addEventListener('click', () => openModal(trigger));
    });

    closeButton?.addEventListener('click', closeModal);

    modal.addEventListener('click', (event) => {
      if (event.target === modal) closeModal();
    });

    modal.addEventListener('close', () => {
      document.body.classList.remove('modal-open');

      if (frame instanceof HTMLIFrameElement) frame.removeAttribute('src');
      if (previousFocus instanceof HTMLElement) previousFocus.focus();
      previousFocus = null;
    });
  }
</script>

<style>
  .video-modal {
    position: fixed;
    top: 50%;
    left: 50%;
    width: min(480px, calc(100vw - 40px), calc(56.25dvh - 22.5px));
    max-width: none;
    max-height: calc(100dvh - 40px);
    padding: 0;
    margin: 0;
    overflow: hidden;
    background: var(--color-text-primary);
    border: 0;
    border-radius: 30px;
    transform: translate(-50%, -50%);
  }

  .video-modal::backdrop {
    background: var(--color-overlay-70);
  }

  .video-player {
    position: relative;
    width: 100%;
    aspect-ratio: 9 / 16;
  }

  .video-player iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .video-close {
    position: absolute;
    z-index: 1;
    top: 20px;
    right: 20px;
    width: 50px;
    height: 50px;
    padding: 0;
    background: var(--color-surface-primary);
    border: 0;
    border-radius: 50%;
    cursor: pointer;
  }

  .video-close img {
    width: 100%;
    height: 100%;
  }

  .video-close:focus-visible {
    outline: 2px solid var(--color-accent-primary);
    outline-offset: 2px;
  }

  :global(body.modal-open) {
    overflow: hidden;
  }

  @media (max-width: 767px) {
    .video-modal {
      width: min(calc(100vw - 32px), calc(56.25dvh - 18px));
      max-height: calc(100dvh - 32px);
      border-radius: 20px;
    }

    .video-close {
      top: 16px;
      right: 16px;
      width: 40px;
      height: 40px;
    }
  }
</style>
