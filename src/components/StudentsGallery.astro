---
const assetPath = `${import.meta.env.BASE_URL}/images/students`;
const assetPathArrow = `${import.meta.env.BASE_URL}/images`;

const students = [
  { image: 'students-1.png', alt: 'Ученицы RG-ballet вместе' },
  { image: 'students-2.png', alt: 'Выступление ученицы RG-ballet' },
  { image: 'students-3.png', alt: 'Группа учениц RG-ballet' },
  { image: 'students-4.png', alt: 'Ученица RG-ballet на сцене' },
  { image: 'students-5.png', alt: 'Танцевальный номер учениц RG-ballet' },
  { image: 'students-6.png', alt: 'Гимнастический элемент ученицы RG-ballet' },
];

---

<section class="students" id="gallery" aria-labelledby="students-title" data-students-gallery>
  <h2 id="students-title">Наши ученицы</h2>

  <div class="students-mosaic">
    <div class="gallery-column gallery-column-tall">
      <img src={`${assetPath}/${students[0].image}`} alt={students[0].alt} loading="lazy" data-gallery-tile />
    </div>

    <div class="gallery-column gallery-column-squares">
      {students.slice(1, 3).map((student) => (
        <img src={`${assetPath}/${student.image}`} alt={student.alt} loading="lazy" data-gallery-tile />
      ))}
    </div>

    <div class="gallery-column gallery-column-tall">
      <img src={`${assetPath}/${students[3].image}`} alt={students[3].alt} loading="lazy" data-gallery-tile />
    </div>

    <div class="gallery-column gallery-column-squares">
      {students.slice(4, 6).map((student) => (
        <img src={`${assetPath}/${student.image}`} alt={student.alt} loading="lazy" data-gallery-tile />
      ))}
    </div>
  </div>

  <div class="students-slider" aria-live="polite">
    {students.slice(0, 5).map((student, index) => (
      <img
        class:list={['student-slide', { 'is-active': index === 0 }]}
        src={`${assetPath}/${student.image}`}
        alt={student.alt}
        loading="lazy"
        data-gallery-slide
      />
    ))}
  </div>

  <div class="gallery-navigation">
    <div class="gallery-dots" aria-label="Выбор фотографии">
      {students.slice(0, 5).map((_, index) => (
        <button
          class:list={['gallery-dot', { 'is-active': index === 0 }]}
          type="button"
          aria-label={`Фотография ${index + 1}`}
          aria-current={index === 0 ? 'true' : undefined}
          data-gallery-dot={index}
        />
      ))}
    </div>

    <div class="gallery-arrows gallery-arrows-desktop" aria-label="Управление галереей">
      <button class="gallery-arrow prev" type="button" aria-label="Предыдущая фотография" data-gallery-prev>
        <img src={`${assetPathArrow}/arrow.svg`} alt="" width="50" height="50" />
      </button>
      <button class="gallery-arrow next" type="button" aria-label="Следующая фотография" data-gallery-next>
        <img src={`${assetPathArrow}/arrow.svg`} alt="" width="50" height="50" />
      </button>
    </div>

    <div class="gallery-arrows gallery-arrows-mobile" aria-label="Управление галереей">
      <button class="gallery-arrow prev" type="button" aria-label="Предыдущая фотография" data-gallery-prev>
        <img src={`${assetPathArrow}/arrow.svg`} alt="" width="30" height="30" />
      </button>
      <button class="gallery-arrow next" type="button" aria-label="Следующая фотография" data-gallery-next>
        <img src={`${assetPathArrow}/arrow.svg`} alt="" width="30" height="30" />
      </button>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('[data-students-gallery]').forEach((gallery) => {
    const slides = [...gallery.querySelectorAll('[data-gallery-slide]')].filter(
      (element) => element instanceof HTMLImageElement,
    );
    const dots = [...gallery.querySelectorAll('[data-gallery-dot]')].filter(
      (element) => element instanceof HTMLButtonElement,
    );
    const tiles = [...gallery.querySelectorAll('[data-gallery-tile]')].filter(
      (element) => element instanceof HTMLImageElement,
    );
    const previousButtons = [...gallery.querySelectorAll('[data-gallery-prev]')].filter(
      (element) => element instanceof HTMLButtonElement,
    );
    const nextButtons = [...gallery.querySelectorAll('[data-gallery-next]')].filter(
      (element) => element instanceof HTMLButtonElement,
    );
    const initialTiles = tiles.map((tile) => ({ src: tile.src, alt: tile.alt }));
    let current = 0;

    const update = (nextIndex = 0) => {
      current = Math.min(Math.max(nextIndex, 0), slides.length - 1);

      slides.forEach((slide, index) => slide.classList.toggle('is-active', index === current));
      dots.forEach((dot, index) => {
        const active = index === current;
        dot.classList.toggle('is-active', active);
        active ? dot.setAttribute('aria-current', 'true') : dot.removeAttribute('aria-current');
      });
      tiles.forEach((tile, index) => {
        const image = initialTiles[(index + current) % initialTiles.length];
        if (!image) return;

        tile.src = image.src;
        tile.alt = image.alt;
      });
      previousButtons.forEach((button) => (button.disabled = current === 0));
      nextButtons.forEach((button) => (button.disabled = current === slides.length - 1));
    };

    previousButtons.forEach((button) => {
      button.addEventListener('click', () => update(current - 1));
    });
    nextButtons.forEach((button) => {
      button.addEventListener('click', () => update(current + 1));
    });
    dots.forEach((dot, index) => dot.addEventListener('click', () => update(index)));
    update(0);
  });
</script>

<style>
  .students {
    position: relative;
    width: min(100%, var(--container-max-width));
    margin: 150px auto 0;
    scroll-margin-top: 30px;
  }

  h2 {
    height: 100px;
    margin: 0;
    color: var(--color-accent-primary);
    font-family: 'Corvetta', 'Cormorant Garamond', serif;
    font-size: clamp(52px, 3.125vw, 60px);
    font-weight: 400;
    line-height: clamp(80px, 5.208vw, 100px);
    text-align: center;
  }

  .gallery-arrows {
    display: flex;
    align-items: center;
  }

  .gallery-navigation {
    position: relative;
    display: flex;
    min-height: 50px;
    margin-top: 20px;
    align-items: center;
    justify-content: center;
  }

  .gallery-arrows-desktop {
    position: absolute;
    right: 0;
    height: 50px;
    gap: 29px;
  }

  .gallery-arrow {
    display: grid;
    width: 50px;
    height: 50px;
    padding: 0;
    place-items: center;
    background: transparent;
    border: 0;
    cursor: pointer;
  }

  .gallery-arrow:disabled {
    opacity: 0.5;
    cursor: default;
  }

  .gallery-arrow img {
    width: 100%;
    height: 100%;
  }

  .gallery-arrow.prev img {
    transform: scaleX(-1);
  }

  .gallery-arrow.next img {
    transform: none;
  }

  .students-mosaic {
    --square-column-width: min(20vw, 360px);

    display: grid;
    width: 100%;
    height: calc(var(--square-column-width) + var(--square-column-width) + 20px);
    margin: 40px auto 0;
    grid-template-columns:
      minmax(0, 1fr)
      var(--square-column-width)
      minmax(0, 1fr)
      var(--square-column-width);
    gap: 20px;
  }

  .gallery-column {
    display: grid;
    min-width: 0;
    gap: 20px;
  }

  .gallery-column-squares {
    grid-template-rows: repeat(2, auto);
  }

  .students-mosaic img {
    width: 100%;
    height: 100%;
    border-radius: 30px;
    object-fit: cover;
  }

  .gallery-column-squares img {
    height: auto;
    aspect-ratio: 1;
  }

  .gallery-column-tall img {
    min-height: 0;
  }

  .gallery-column-tall {
    min-height: 0;
    grid-template-rows: 1fr;
    overflow: hidden;
  }

  .gallery-dots {
    display: flex;
    height: 24px;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }

  .gallery-dot {
    width: 24px;
    height: 24px;
    padding: 0;
    background: transparent;
    border: 2px solid var(--color-accent-primary);
    border-radius: 50%;
    cursor: pointer;
  }

  .gallery-dot.is-active {
    background: var(--color-accent-primary);
  }

  .gallery-arrows-mobile,
  .students-slider {
    display: none;
  }

  @media (max-width: 1919px) {
    .students {
      width: auto;
      margin-inline: var(--page-gutter);
    }

  }

  @media (max-width: 1199px) and (min-width: 768px) {
    .students {
      min-height: auto;
      margin-top: 90px;
    }

    h2 {
      font-size: 52px;
      line-height: 80px;
    }

    .gallery-navigation {
      min-height: 30px;
    }

    .gallery-arrows-desktop {
      height: 30px;
      gap: 16px;
    }

    .gallery-arrow {
      width: 30px;
      height: 30px;
    }

    .gallery-dots {
      height: 16px;
      gap: 6px;
    }

    .gallery-dot {
      width: 16px;
      height: 16px;
    }

  }

  @media (max-width: 767px) {
    .students {
      width: auto;
      min-height: 596px;
      margin: 70px 20px 0;
    }

    h2 {
      height: 60px;
      max-width: 100%;
      font-size: clamp(30px, 8.89vw, 40px);
      line-height: clamp(50px, 15vw, 60px);
    }

    .gallery-arrows-desktop,
    .students-mosaic {
      display: none;
    }

    .gallery-arrows-mobile {
      position: absolute;
      right: 0;
      display: flex;
      height: 30px;
      gap: 16px;
    }

    .gallery-navigation {
      min-height: 30px;
      margin-top: 20px;
    }

    .gallery-arrows-mobile .gallery-arrow {
      width: 30px;
      height: 30px;
    }

    .students-slider {
      position: relative;
      display: block;
      width: 100%;
      height: 437px;
      margin-top: 62px;
      overflow: hidden;
      border-radius: 30px;
      background: var(--color-photo-placeholder);
    }

    .student-slide {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      opacity: 0;
      object-fit: cover;
      transition: opacity 200ms ease;
    }

    .student-slide.is-active {
      z-index: 1;
      opacity: 1;
    }

    .gallery-dots {
      height: 16px;
      gap: 6px;
    }

    .gallery-dot {
      width: 16px;
      height: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .student-slide {
      transition: none;
    }
  }
</style>
