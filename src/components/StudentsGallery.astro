---
import { getGalleryPhotos } from '../config/galleryPhotos.js';

const assetPath = `${import.meta.env.BASE_URL}/images/students`;
const assetPathArrow = `${import.meta.env.BASE_URL}/images`;

const students = await getGalleryPhotos('students', {
  'students-1.png': 'Ученицы RG-ballet вместе',
  'students-2.png': 'Выступление ученицы RG-ballet',
  'students-3.png': 'Группа учениц RG-ballet',
  'students-4.png': 'Ученица RG-ballet на сцене',
  'students-5.png': 'Танцевальный номер учениц RG-ballet',
  'students-6.png': 'Гимнастический элемент ученицы RG-ballet',
}, 'Ученицы RG-ballet');

---

<section class="students" id="gallery" aria-labelledby="students-title" data-students-gallery>
  <h2 id="students-title">Наши ученицы</h2>

  <div class="students-mosaic">
    <div class="gallery-column gallery-column-tall">
      <img src={`${assetPath}/${encodeURIComponent(students[0].image)}`} alt={students[0].alt} loading="lazy" data-gallery-tile />
    </div>

    <div class="gallery-column gallery-column-squares">
      {students.slice(1, 3).map((student) => (
        <img src={`${assetPath}/${encodeURIComponent(student.image)}`} alt={student.alt} loading="lazy" data-gallery-tile />
      ))}
    </div>

    <div class="gallery-column gallery-column-tall">
      <img src={`${assetPath}/${encodeURIComponent(students[3].image)}`} alt={students[3].alt} loading="lazy" data-gallery-tile />
    </div>

    <div class="gallery-column gallery-column-squares">
      {students.slice(4, 6).map((student) => (
        <img src={`${assetPath}/${encodeURIComponent(student.image)}`} alt={student.alt} loading="lazy" data-gallery-tile />
      ))}
    </div>
  </div>

  <div class="students-slider" aria-live="polite">
    {students.map((student, index) => (
      <img
        class:list={['student-slide', { 'is-active': index === 0 }]}
        src={`${assetPath}/${encodeURIComponent(student.image)}`}
        alt={student.alt}
        aria-hidden={index === 0 ? 'false' : 'true'}
        loading="lazy"
        data-gallery-slide
      />
    ))}
  </div>

  <div class="gallery-navigation">
    <div class="gallery-position">
      <div class="gallery-dots" aria-label="Выбор фотографии">
        {students.slice(0, 5).map((_, index) => (
          <button
            class:list={['gallery-dot', { 'is-active': index === 0 }]}
            type="button"
            aria-label={`Фотография ${index + 1} из ${students.length}`}
            aria-current={index === 0 ? 'true' : undefined}
            data-gallery-dot={index}
          />
        ))}
      </div>
      <span class="gallery-counter" aria-live="polite" data-gallery-counter>1 из {students.length}</span>
    </div>

    <div class="gallery-arrows gallery-arrows-desktop" aria-label="Управление галереей">
      <button class="gallery-arrow prev" type="button" aria-label="Предыдущая фотография" data-gallery-prev>
        <img src={`${assetPathArrow}/arrow.svg`} alt="" width="50" height="50" />
      </button>
      <button class="gallery-arrow next" type="button" aria-label="Следующая фотография" data-gallery-next>
        <img src={`${assetPathArrow}/arrow.svg`} alt="" width="50" height="50" />
      </button>
    </div>

    <div class="gallery-arrows gallery-arrows-mobile" aria-label="Управление галереей">
      <button class="gallery-arrow prev" type="button" aria-label="Предыдущая фотография" data-gallery-prev>
        <img src={`${assetPathArrow}/arrow.svg`} alt="" width="30" height="30" />
      </button>
      <button class="gallery-arrow next" type="button" aria-label="Следующая фотография" data-gallery-next>
        <img src={`${assetPathArrow}/arrow.svg`} alt="" width="30" height="30" />
      </button>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-students-gallery]').forEach((gallery) => {
    const slides = [...gallery.querySelectorAll('[data-gallery-slide]')].filter(
      (element) => element instanceof HTMLImageElement,
    );
    const dots = [...gallery.querySelectorAll('[data-gallery-dot]')].filter(
      (element) => element instanceof HTMLButtonElement,
    );
    const tiles = [...gallery.querySelectorAll('[data-gallery-tile]')].filter(
      (element) => element instanceof HTMLImageElement,
    );
    const previousButtons = [...gallery.querySelectorAll('[data-gallery-prev]')].filter(
      (element) => element instanceof HTMLButtonElement,
    );
    const nextButtons = [...gallery.querySelectorAll('[data-gallery-next]')].filter(
      (element) => element instanceof HTMLButtonElement,
    );
    const slider = gallery.querySelector<HTMLElement>('.students-slider');
    const counter = gallery.querySelector<HTMLElement>('[data-gallery-counter]');
    const images = slides.map((slide) => ({ src: slide.src, alt: slide.alt }));
    let current = 0;
    let swipeStartX = 0;
    let swipeStartY = 0;

    const update = (nextIndex = 0) => {
      current = Math.min(Math.max(nextIndex, 0), slides.length - 1);

      slides.forEach((slide, index) => {
        const active = index === current;
        slide.classList.toggle('is-active', active);
        slide.setAttribute('aria-hidden', String(!active));
      });
      const firstDot = Math.min(Math.max(current - Math.floor(dots.length / 2), 0), slides.length - dots.length);
      dots.forEach((dot, index) => {
        const photoIndex = firstDot + index;
        const active = photoIndex === current;
        dot.dataset.galleryDot = String(photoIndex);
        dot.setAttribute('aria-label', `Фотография ${photoIndex + 1} из ${slides.length}`);
        dot.classList.toggle('is-active', active);
        active ? dot.setAttribute('aria-current', 'true') : dot.removeAttribute('aria-current');
      });
      if (counter) counter.textContent = `${current + 1} из ${slides.length}`;
      tiles.forEach((tile, index) => {
        const image = images[(index + current) % images.length];
        if (!image) return;

        tile.src = image.src;
        tile.alt = image.alt;
      });
      previousButtons.forEach((button) => (button.disabled = current === 0));
      nextButtons.forEach((button) => (button.disabled = current === slides.length - 1));
    };

    previousButtons.forEach((button) => {
      button.addEventListener('click', () => update(current - 1));
    });
    nextButtons.forEach((button) => {
      button.addEventListener('click', () => update(current + 1));
    });
    dots.forEach((dot) => dot.addEventListener('click', () => update(Number(dot.dataset.galleryDot))));
    gallery.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
      if (!(event.target instanceof HTMLElement) || !event.target.closest('.gallery-navigation')) return;

      event.preventDefault();
      update(current + (event.key === 'ArrowRight' ? 1 : -1));
    });

    slider?.addEventListener('pointerdown', (event) => {
      if (event.pointerType === 'mouse') return;

      swipeStartX = event.clientX;
      swipeStartY = event.clientY;
      (event.currentTarget as HTMLElement).setPointerCapture(event.pointerId);
    });

    slider?.addEventListener('pointerup', (event) => {
      if (event.pointerType === 'mouse') return;

      const distanceX = event.clientX - swipeStartX;
      const distanceY = event.clientY - swipeStartY;

      if (Math.abs(distanceX) >= 50 && Math.abs(distanceX) > Math.abs(distanceY)) {
        update(current + (distanceX < 0 ? 1 : -1));
      }
    });

    update(0);
  });
</script>

<style>
  .students {
    position: relative;
    width: min(100%, var(--container-max-width));
    margin: var(--section-space) auto 0;
    scroll-margin-top: 30px;
    container-type: inline-size;
  }

  h2 {
    height: 100px;
    margin: 0;
    color: var(--color-accent-primary);
    font-family: 'Corvetta', 'Cormorant Garamond', serif;
    font-size: var(--section-title-size);
    font-weight: 400;
    line-height: clamp(80px, 5.208vw, 100px);
    text-align: center;
    white-space: nowrap;
  }

  .gallery-arrows {
    display: flex;
    align-items: center;
  }

  .gallery-navigation {
    position: relative;
    display: flex;
    min-height: 50px;
    margin-top: 20px;
    align-items: center;
    justify-content: center;
  }

  .gallery-position {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .gallery-counter {
    font-size: 16px;
    line-height: 24px;
    white-space: nowrap;
  }

  .gallery-arrows-desktop {
    position: absolute;
    right: 0;
    height: 50px;
    gap: 29px;
  }

  .gallery-arrow {
    display: grid;
    width: 50px;
    height: 50px;
    padding: 0;
    place-items: center;
    background: transparent;
    border: 0;
    cursor: pointer;
  }

  .gallery-arrow:disabled {
    opacity: 0.5;
    cursor: default;
  }

  .gallery-arrow img {
    width: 100%;
    height: 100%;
  }

  .gallery-arrow.prev img {
    transform: scaleX(-1);
  }

  .gallery-arrow.next img {
    transform: none;
  }

  .students-mosaic {
    --square-column-width: min(20vw, 360px);

    display: grid;
    width: 100%;
    height: calc(var(--square-column-width) + var(--square-column-width) + 20px);
    margin: 40px auto 0;
    grid-template-columns:
      minmax(0, 1fr)
      var(--square-column-width)
      minmax(0, 1fr)
      var(--square-column-width);
    gap: 20px;
  }

  .gallery-column {
    display: grid;
    min-width: 0;
    gap: 20px;
  }

  .gallery-column-squares {
    grid-template-rows: repeat(2, auto);
  }

  .students-mosaic img {
    width: 100%;
    height: 100%;
    border-radius: 30px;
    object-fit: cover;
  }

  .gallery-column-squares img {
    height: auto;
    aspect-ratio: 1;
  }

  .gallery-column-tall img {
    min-height: 0;
  }

  .gallery-column-tall {
    min-height: 0;
    grid-template-rows: 1fr;
    overflow: hidden;
  }

  .gallery-dots {
    display: flex;
    height: 24px;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }

  .gallery-dot {
    width: 24px;
    height: 24px;
    padding: 0;
    background: transparent;
    border: 2px solid var(--color-accent-primary);
    border-radius: 50%;
    cursor: pointer;
  }

  .gallery-dot.is-active {
    background: var(--color-accent-primary);
  }

  .gallery-arrows-mobile,
  .students-slider {
    display: none;
  }

  @media (width < 1920px) {
    .students {
      width: auto;
      margin-inline: var(--page-gutter);
    }

  }

  @media (768px <= width < 1200px) {
    .students {
      min-height: auto;
      margin-top: var(--section-space);
    }

    h2 {
      line-height: 80px;
    }

    .students-mosaic {
      width: min(100%, 1100px);
      height: auto;
      margin-inline: auto;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 12px;
    }

    .gallery-column {
      gap: 12px;
    }

    .gallery-column:nth-child(4) {
      display: none;
    }

    .gallery-navigation {
      min-height: 30px;
    }

    .gallery-arrows-desktop {
      height: 30px;
      gap: 16px;
    }

    .gallery-arrow {
      width: 30px;
      height: 30px;
    }

    .gallery-dots {
      height: 16px;
      gap: 6px;
    }

    .gallery-position {
      gap: 10px;
    }

    .gallery-counter {
      font-size: 14px;
      line-height: 16px;
    }

    .gallery-dot {
      width: 16px;
      height: 16px;
    }

  }

  @media (width < 768px) {
    .students {
      width: auto;
      min-height: 596px;
      margin: var(--section-space) 20px 0;
    }

    h2 {
      height: 60px;
      max-width: 100%;
      line-height: clamp(50px, 15vw, 60px);
    }

    .gallery-arrows-desktop,
    .students-mosaic {
      display: none;
    }

    .gallery-arrows-mobile {
      display: none;
    }

    .gallery-navigation {
      min-height: 30px;
      margin-top: 20px;
    }

    .gallery-arrows-mobile .gallery-arrow {
      width: 30px;
      height: 30px;
    }

    .students-slider {
      position: relative;
      display: block;
      width: min(100%, 420px);
      height: auto;
      aspect-ratio: 320 / 437;
      margin: 62px auto 0;
      overflow: hidden;
      border-radius: 30px;
      background: var(--color-photo-placeholder);
      touch-action: pan-y;
      user-select: none;
    }

    .student-slide {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      opacity: 0;
      object-fit: cover;
      transition: opacity 200ms ease;
    }

    .student-slide.is-active {
      z-index: 1;
      opacity: 1;
    }

    .gallery-dots {
      height: 16px;
      gap: 6px;
    }

    .gallery-position {
      gap: 10px;
    }

    .gallery-counter {
      font-size: 14px;
      line-height: 16px;
    }

    .gallery-dot {
      width: 16px;
      height: 16px;
    }
  }

  @media (width < 768px) {
    h2 {
      font-size: clamp(30px, calc(24px + 2.5cqi), 32px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .student-slide {
      transition: none;
    }
  }
</style>
