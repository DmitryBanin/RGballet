---
const assetPath = '/images';

const students = [
  { image: 'students-1.png', alt: 'Ученицы RG-ballet вместе' },
  { image: 'students-2.png', alt: 'Выступление ученицы RG-ballet' },
  { image: 'students-3.png', alt: 'Группа учениц RG-ballet' },
  { image: 'students-4.png', alt: 'Ученица RG-ballet на сцене' },
  { image: 'students-5.png', alt: 'Танцевальный номер учениц RG-ballet' },
  { image: 'students-6.png', alt: 'Гимнастический элемент ученицы RG-ballet' },
];

const desktopOrder = [students[0], students[5], students[1], students[2], students[4], students[3]];
---

<section class="students" aria-labelledby="students-title" data-students-gallery>
  <h2 id="students-title">Наши ученицы</h2>

  <div class="gallery-arrows gallery-arrows-desktop" aria-label="Управление галереей">
    <button class="gallery-arrow prev" type="button" aria-label="Предыдущая фотография" data-gallery-prev>
      <img src={`${assetPath}/students-arrow.svg`} alt="" width="50" height="50" />
    </button>
    <button class="gallery-arrow next" type="button" aria-label="Следующая фотография" data-gallery-next>
      <img src={`${assetPath}/students-arrow.svg`} alt="" width="50" height="50" />
    </button>
  </div>

  <div class="students-mosaic">
    {desktopOrder.map((student) => (
      <img src={`${assetPath}/${student.image}`} alt={student.alt} loading="lazy" data-gallery-tile />
    ))}
  </div>

  <div class="gallery-arrows gallery-arrows-mobile" aria-label="Управление галереей">
    <button class="gallery-arrow prev" type="button" aria-label="Предыдущая фотография" data-gallery-prev>
      <img src={`${assetPath}/students-arrow.svg`} alt="" width="30" height="30" />
    </button>
    <button class="gallery-arrow next" type="button" aria-label="Следующая фотография" data-gallery-next>
      <img src={`${assetPath}/students-arrow.svg`} alt="" width="30" height="30" />
    </button>
  </div>

  <div class="students-slider" aria-live="polite">
    {students.slice(0, 5).map((student, index) => (
      <img
        class:list={['student-slide', { 'is-active': index === 0 }]}
        src={`${assetPath}/${student.image}`}
        alt={student.alt}
        loading="lazy"
        data-gallery-slide
      />
    ))}
  </div>

  <div class="gallery-dots" aria-label="Выбор фотографии">
    {students.slice(0, 5).map((_, index) => (
      <button
        class:list={['gallery-dot', { 'is-active': index === 0 }]}
        type="button"
        aria-label={`Фотография ${index + 1}`}
        aria-current={index === 0 ? 'true' : undefined}
        data-gallery-dot={index}
      />
    ))}
  </div>
</section>

<script>
  document.querySelectorAll('[data-students-gallery]').forEach((gallery) => {
    const slides = [...gallery.querySelectorAll('[data-gallery-slide]')];
    const dots = [...gallery.querySelectorAll('[data-gallery-dot]')];
    const tiles = [...gallery.querySelectorAll('[data-gallery-tile]')];
    const previousButtons = [...gallery.querySelectorAll('[data-gallery-prev]')];
    const nextButtons = [...gallery.querySelectorAll('[data-gallery-next]')];
    const initialTiles = tiles.map((tile) => ({ src: tile.src, alt: tile.alt }));
    let current = 0;

    const update = (nextIndex) => {
      current = Math.min(Math.max(nextIndex, 0), slides.length - 1);

      slides.forEach((slide, index) => slide.classList.toggle('is-active', index === current));
      dots.forEach((dot, index) => {
        const active = index === current;
        dot.classList.toggle('is-active', active);
        active ? dot.setAttribute('aria-current', 'true') : dot.removeAttribute('aria-current');
      });
      tiles.forEach((tile, index) => {
        const image = initialTiles[(index + current) % initialTiles.length];
        tile.src = image.src;
        tile.alt = image.alt;
      });
      previousButtons.forEach((button) => (button.disabled = current === 0));
      nextButtons.forEach((button) => (button.disabled = current === slides.length - 1));
    };

    previousButtons.forEach((button) => {
      button.addEventListener('click', () => update(current - 1));
    });
    nextButtons.forEach((button) => {
      button.addEventListener('click', () => update(current + 1));
    });
    dots.forEach((dot, index) => dot.addEventListener('click', () => update(index)));
    update(0);
  });
</script>

<style>
  .students {
    position: relative;
    width: min(100%, var(--container-max-width));
    min-height: 1014px;
    margin: 150px auto 0;
  }

  h2 {
    height: 100px;
    margin: 0;
    color: var(--color-accent-primary);
    font-family: 'Corvetta', 'Cormorant Garamond', serif;
    font-size: 60px;
    font-weight: 400;
    line-height: 100px;
    text-align: center;
  }

  .gallery-arrows {
    display: flex;
    align-items: center;
  }

  .gallery-arrows-desktop {
    position: absolute;
    top: 67px;
    right: 0;
    gap: 29px;
  }

  .gallery-arrow {
    display: grid;
    width: 50px;
    height: 50px;
    padding: 0;
    place-items: center;
    background: transparent;
    border: 0;
    cursor: pointer;
  }

  .gallery-arrow:disabled {
    opacity: 0.5;
    cursor: default;
  }

  .gallery-arrow img {
    width: 100%;
    height: 100%;
  }

  .gallery-arrow.prev img {
    transform: scaleX(-1);
  }

  .gallery-arrow.next img {
    transform: none;
  }

  .students-mosaic {
    display: grid;
    height: 820px;
    margin-top: 40px;
    grid-template-columns: 600fr 445fr 445fr 290fr;
    grid-template-rows: repeat(2, 400px);
    gap: 20px;
  }

  .students-mosaic img {
    width: 100%;
    height: 100%;
    border-radius: 30px;
    object-fit: cover;
  }

  .students-mosaic img:first-child {
    grid-column: 1;
    grid-row: 1 / 3;
  }

  .students-mosaic img:nth-child(2) {
    grid-column: 2;
    grid-row: 1;
  }

  .students-mosaic img:nth-child(3) {
    grid-column: 2;
    grid-row: 2;
  }

  .students-mosaic img:nth-child(4) {
    grid-column: 3;
    grid-row: 1 / 3;
  }

  .students-mosaic img:nth-child(5) {
    grid-column: 4;
    grid-row: 1;
  }

  .students-mosaic img:nth-child(6) {
    grid-column: 4;
    grid-row: 2;
  }

  .gallery-dots {
    display: flex;
    height: 24px;
    margin-top: 30px;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }

  .gallery-dot {
    width: 24px;
    height: 24px;
    padding: 0;
    background: transparent;
    border: 2px solid var(--color-accent-primary);
    border-radius: 50%;
    cursor: pointer;
  }

  .gallery-dot.is-active {
    background: var(--color-accent-primary);
  }

  .gallery-arrows-mobile,
  .students-slider {
    display: none;
  }

  @media (max-width: 1919px) {
    .students {
      width: auto;
      margin-inline: var(--page-gutter);
    }

    .students-mosaic {
      grid-template-columns: 1.35fr 1fr 1fr 0.65fr;
    }
  }

  @media (max-width: 1199px) and (min-width: 768px) {
    .students {
      min-height: auto;
      margin-top: 90px;
    }

    h2 {
      font-size: 52px;
      line-height: 80px;
    }

    .gallery-arrows-desktop {
      top: 57px;
    }

    .students-mosaic {
      height: 600px;
      margin-top: 30px;
      grid-template-rows: repeat(2, 290px);
    }
  }

  @media (max-width: 767px) {
    .students {
      width: auto;
      min-height: 596px;
      margin: 70px 20px 0;
    }

    h2 {
      height: 60px;
      font-size: 40px;
      line-height: 60px;
    }

    .gallery-arrows-desktop,
    .students-mosaic {
      display: none;
    }

    .gallery-arrows-mobile {
      display: flex;
      height: 30px;
      margin-top: 20px;
      justify-content: center;
      gap: 16px;
    }

    .gallery-arrows-mobile .gallery-arrow {
      width: 30px;
      height: 30px;
    }

    .students-slider {
      position: relative;
      display: block;
      width: 100%;
      height: 437px;
      margin-top: 14px;
      overflow: hidden;
      border-radius: 30px;
      background: var(--color-photo-placeholder);
    }

    .student-slide {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      opacity: 0;
      object-fit: cover;
      transition: opacity 200ms ease;
    }

    .student-slide.is-active {
      z-index: 1;
      opacity: 1;
    }

    .gallery-dots {
      height: 16px;
      margin-top: 19px;
      gap: 6px;
    }

    .gallery-dot {
      width: 16px;
      height: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .student-slide {
      transition: none;
    }
  }
</style>
