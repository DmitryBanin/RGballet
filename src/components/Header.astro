---
import { contacts } from '../config/contacts.js';

const leftNavigation = [
  { label: 'О нас', href: '#about' },
  { label: 'Наши педагоги', href: '#teachers' },
  { label: 'Фотогалерея', href: '#gallery' },
];

const rightNavigation = [
  { label: 'Стоимость', href: '#pricing' },
  { label: 'Отзывы', href: '#reviews' },
  { label: 'Контакты', href: '#contacts' },
];

const assetPath = `${import.meta.env.BASE_URL}/images`;
---

<header class="site-header">
  <div class="header-inner">
    <button class="mobile-menu-button" type="button" aria-label="Открыть меню" aria-expanded="false">
      <svg class="mobile-menu-icon ham hamRotate ham4" viewBox="0 0 100 100" aria-hidden="true">
        <path
          class="line top"
          d="m 70,33 h -40 c 0,0 -8.5,-0.149796 -8.5,8.5 0,8.649796 8.5,8.5 8.5,8.5 h 20 v -20"
        />
        <path class="line middle" d="m 70,50 h -40" />
        <path
          class="line bottom"
          d="m 30,67 h 40 c 0,0 8.5,0.149796 8.5,-8.5 0,-8.649796 -8.5,-8.5 -8.5,-8.5 h -20 v 20"
        />
      </svg>
    </button>

    <nav class="navigation navigation-left" aria-label="Основная навигация">
      {leftNavigation.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <a class="logo" href="/" aria-label="RGballet — на главную">
      <img src={`${assetPath}/logo.png`} alt="RGballet" width="135" height="60" />
    </a>

    <nav class="navigation navigation-right" aria-label="Дополнительная навигация">
      {rightNavigation.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
<!-- socials -->
    <div class="socials" aria-label="Контакты">
      <a class="social-icon" href={contacts.max} aria-label="Открыть MAX">
        <img src={`${assetPath}/social-MAX.svg`} alt="" width="50" height="50" />
      </a>
      <a class="social-icon" href={contacts.email.href} aria-label="Написать на электронную почту">
        <img src={`${assetPath}/social-mail.svg`} alt="" width="50" height="50" />
      </a>
      <a class="social-icon" href={contacts.phone.href} aria-label={`Позвонить: ${contacts.phone.display}`}>
        <img src={`${assetPath}/social-phone.svg`} alt="" width="50" height="50" />
      </a>
    </div>

    <a class="mobile-phone" href={contacts.phone.href} aria-label={`Позвонить: ${contacts.phone.display}`}>
      <img src={`${assetPath}/social-phone.svg`} alt="" width="40" height="40" />
    </a>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 10;
    height: 80px;
    background: var(--color-surface-primary);
  }

  .header-inner {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .logo {
    position: absolute;
    top: 10px;
    left: 50%;
    width: 135px;
    height: 60px;
    transform: translateX(-50%);
  }

  .logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .navigation {
    position: absolute;
    top: 29px;
    display: flex;
    align-items: center;
    gap: clamp(34px, 4.167vw, 80px);
    white-space: nowrap;
  }

  .navigation-left {
    right: calc(50% + 164px);
  }

  .navigation-right {
    left: calc(50% + 165px);
  }

  .navigation a {
    font-size: 18px;
    line-height: 25px;
    text-decoration: none;
    transition: color 160ms ease;
  }

  .navigation a:hover {
    color: var(--color-accent-primary);
  }

  .socials {
    position: absolute;
    top: 15px;
    right: 40px;
    display: flex;
    gap: 16px;
  }

  .social-icon {
    display: grid;
    width: 50px;
    height: 50px;
    place-items: center;
  }

  .mobile-menu-button,
  .mobile-phone {
    display: none;
  }

  .mobile-menu-icon {
    display: block;
    width: 100%;
    height: 100%;
  }

  .ham {
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transform-origin: center;
    transition: transform 400ms;
    user-select: none;
  }

  .hamRotate.active {
    transform: rotate(45deg);
  }

  .line {
    fill: none;
    stroke: #000;
    stroke-width: 5.5;
    stroke-linecap: round;
    transition:
      stroke-dasharray 400ms,
      stroke-dashoffset 400ms;
  }

  .ham4 .top,
  .ham4 .bottom {
    stroke-dasharray: 40 121;
  }

  .ham4.active .top,
  .ham4.active .bottom {
    stroke-dashoffset: -68px;
  }

  @media (max-width: 1500px) {
    .navigation {
      gap: 34px;
    }

    .socials {
      right: 20px;
      gap: 10px;
    }

    .social-icon {
      width: 42px;
      height: 42px;
    }

    .socials {
      top: 19px;
    }

    .social-icon img {
      max-width: 100%;
      max-height: 100%;
    }

  }

  @media (max-width: 1199px) {
    .navigation,
    .socials {
      display: none;
    }

    .mobile-menu-button,
    .mobile-phone {
      position: absolute;
      top: 10px;
      display: block;
      width: 40px;
      height: 40px;
      padding: 0;
      border: 0;
      background: transparent;
    }

    .mobile-menu-button {
      left: 20px;
      cursor: pointer;
    }

    .mobile-phone {
      right: 20px;
    }
  }

  @media (max-width: 767px) {
    .site-header {
      height: 60px;
    }

    .logo {
      top: 11px;
      width: 88px;
      height: 39px;
    }
  }
</style>

<script>
  const menuButton = document.querySelector('.mobile-menu-button');
  const menuIcon = menuButton?.querySelector('.ham');

  menuButton?.addEventListener('click', () => {
    const isActive = menuIcon?.classList.toggle('active') ?? false;

    menuButton.setAttribute('aria-expanded', String(isActive));
    menuButton.setAttribute('aria-label', isActive ? 'Закрыть меню' : 'Открыть меню');
  });
</script>
