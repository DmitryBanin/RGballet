---
import { contacts } from '../config/contacts.js';

const leftNavigation = [
  { label: 'О нас', href: '#about' },
  { label: 'Наши педагоги', href: '#teachers' },
  { label: 'Фотогалерея', href: '#gallery' },
];

const rightNavigation = [
  { label: 'Стоимость', href: '#pricing' },
  { label: 'Отзывы', href: '#reviews' },
  { label: 'Контакты', href: '#contacts' },
];

const mobileNavigation = [...leftNavigation, ...rightNavigation];
const mobilePhone = contacts.phone.display.replace('+7', '8');
const assetPath = `${import.meta.env.BASE_URL}/images`;
---

<header class="site-header">
  <div class="header-inner">
    <button
      class="mobile-menu-button"
      type="button"
      aria-label="Открыть меню"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-button
    >
      <svg class="mobile-menu-icon ham hamRotate ham4" viewBox="0 0 100 100" aria-hidden="true">
        <path
          class="line top"
          d="m 70,33 h -40 c 0,0 -8.5,-0.149796 -8.5,8.5 0,8.649796 8.5,8.5 8.5,8.5 h 20 v -20"
        />
        <path class="line middle" d="m 70,50 h -40" />
        <path
          class="line bottom"
          d="m 30,67 h 40 c 0,0 8.5,0.149796 8.5,-8.5 0,-8.649796 -8.5,-8.5 -8.5,-8.5 h -20 v 20"
        />
      </svg>
    </button>

    <div class="header-side header-side-left">
      <nav class="navigation navigation-left" aria-label="Основная навигация">
        {leftNavigation.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
    </div>

    <a class="logo" href="/" aria-label="RGballet — на главную">
      <img src={`${assetPath}/logo.png`} alt="RGballet" width="135" height="60" />
    </a>

    <div class="header-side header-side-right">
      <nav class="navigation navigation-right" aria-label="Дополнительная навигация">
        {rightNavigation.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>

      <div class="socials" aria-label="Контакты">
        <a class="social-icon" href={contacts.max} aria-label="Открыть MAX">
          <img src={`${assetPath}/social-MAX.svg`} alt="" width="50" height="50" />
        </a>
        <a class="social-icon" href={contacts.email.href} aria-label="Написать на электронную почту">
          <img src={`${assetPath}/social-mail.svg`} alt="" width="50" height="50" />
        </a>
        <a class="social-icon" href={contacts.phone.href} aria-label={`Позвонить: ${contacts.phone.display}`}>
          <img src={`${assetPath}/social-phone.svg`} alt="" width="50" height="50" />
        </a>
      </div>
    </div>

    <a class="mobile-phone" href={contacts.phone.href} aria-label={`Позвонить: ${contacts.phone.display}`}>
      <img src={`${assetPath}/social-phone.svg`} alt="" width="40" height="40" />
    </a>
  </div>

  <div class="mobile-menu-backdrop" aria-hidden="true" data-menu-backdrop></div>

  <aside
    class="mobile-menu"
    id="mobile-menu"
    role="dialog"
    aria-label="Мобильное меню"
    aria-modal="true"
    aria-hidden="true"
    inert
    data-mobile-menu
  >
    <nav class="mobile-navigation" aria-label="Мобильная навигация">
      {mobileNavigation.map((item) => <a href={item.href} data-menu-link>{item.label}</a>)}
    </nav>

    <a class="mobile-menu-contact" href={contacts.phone.href}>
      <img src={`${assetPath}/contact-phone.svg`} alt="" width="24" height="24" />
      <strong>{mobilePhone}</strong>
    </a>

    <div class="mobile-menu-socials" aria-label="Социальные сети">
      <a href={contacts.email.href} aria-label="Написать на электронную почту">
        <img src={`${assetPath}/social-mail.svg`} alt="" width="40" height="40" />
      </a>
      <a href={contacts.vk} target="_blank" rel="noopener noreferrer" aria-label="Открыть VK">
        <img src={`${assetPath}/social-vk.svg`} alt="" width="40" height="40" />
      </a>
      <a href={contacts.max} target="_blank" rel="noopener noreferrer" aria-label="Открыть MAX">
        <img src={`${assetPath}/social-MAX.svg`} alt="" width="40" height="40" />
      </a>
    </div>
  </aside>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 10;
    height: 80px;
    background: var(--color-surface-primary);
  }

  .header-inner {
    display: flex;
    padding-inline: var(--page-gutter);
    align-items: center;
    width: 100%;
    height: 100%;
  }

  .header-side {
    display: flex;
    min-width: 0;
    flex: 1 1 0;
    align-items: center;
  }

  .header-side-left {
    padding-right: clamp(34px, 5.052vw, 97px);
    justify-content: flex-end;
  }

  .header-side-right {
    padding-left: clamp(34px, 5.052vw, 97px);
  }

  .logo {
    width: 135px;
    height: 60px;
    flex: 0 0 135px;
  }

  .logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .navigation {
    display: flex;
    align-items: center;
    gap: clamp(34px, 4.167vw, 80px);
    white-space: nowrap;
  }

  .navigation a {
    font-size: 18px;
    line-height: 25px;
    text-decoration: none;
    transition: color 160ms ease;
  }

  .navigation a:hover {
    color: var(--color-accent-primary);
  }

  .socials {
    display: flex;
    margin-left: auto;
    align-items: center;
    justify-content: center;
    gap: 16px;
    flex: 0 0 auto;
  }

  .social-icon {
    display: grid;
    width: 50px;
    height: 50px;
    flex: 0 0 50px;
    place-items: center;
    line-height: 0;
  }

  .social-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .mobile-menu-button,
  .mobile-phone,
  .mobile-menu,
  .mobile-menu-backdrop {
    display: none;
  }

  .mobile-menu-icon {
    display: block;
    width: 100%;
    height: 100%;
  }

  .ham {
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transform-origin: center;
    transition: transform 400ms;
    user-select: none;
  }

  .hamRotate.active {
    transform: rotate(45deg);
  }

  .line {
    fill: none;
    stroke: var(--color-black);
    stroke-width: 5.5;
    stroke-linecap: round;
    transition:
      stroke-dasharray 400ms,
      stroke-dashoffset 400ms;
  }

  .ham4 .top,
  .ham4 .bottom {
    stroke-dasharray: 40 121;
  }

  .ham4.active .top,
  .ham4.active .bottom {
    stroke-dashoffset: -68px;
  }

  @media (max-width: 1500px) {
    .site-header {
      height: 60px;
    }

    .logo {
      width: 108px;
      height: 48px;
      flex-basis: 108px;
    }

    .navigation {
      gap: 34px;
    }

    .socials {
      gap: 10px;
    }

    .social-icon {
      width: 40px;
      height: 40px;
      flex-basis: 40px;
    }
  }

  @media (max-width: 1199px) {
    .header-inner {
      justify-content: space-between;
    }

    .header-side {
      display: none;
    }

    .mobile-menu-button,
    .mobile-phone {
      position: relative;
      display: block;
      width: 40px;
      height: 40px;
      flex: 0 0 40px;
      padding: 0;
      border: 0;
      background: transparent;
    }

    .mobile-menu-button {
      z-index: 103;
      cursor: pointer;
    }

    .mobile-menu-backdrop {
      position: fixed;
      z-index: 100;
      display: block;
      visibility: hidden;
      background: var(--color-overlay-70);
      opacity: 0;
      inset: 0;
      transition:
        opacity 240ms ease,
        visibility 240ms;
    }

    .mobile-menu-backdrop.is-open {
      visibility: visible;
      opacity: 1;
    }

    .mobile-menu {
      position: fixed;
      top: 0;
      bottom: 0;
      left: 0;
      z-index: 101;
      display: flex;
      width: min(272px, 100vw);
      min-height: 100vh;
      min-height: 100dvh;
      padding: 77px 20px 30px;
      overflow-y: auto;
      flex-direction: column;
      background: var(--color-surface-primary);
      overscroll-behavior: contain;
      transform: translateX(-100%);
      transition: transform 240ms ease;
    }

    .mobile-menu.is-open {
      transform: translateX(0);
    }

    .mobile-navigation {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .mobile-navigation a {
      font-size: 16px;
      font-weight: 300;
      line-height: 22px;
      text-decoration: none;
    }

    .mobile-menu-contact {
      display: flex;
      padding-top: 22px;
      margin-top: 15px;
      align-items: center;
      gap: 13px;
      border-top: 1px solid rgb(35 35 35 / 15%);
      text-decoration: none;
    }

    .mobile-menu-contact img {
      width: 24px;
      height: 24px;
      object-fit: contain;
    }

    .mobile-menu-contact strong {
      font-size: 20px;
      font-weight: 700;
      line-height: 28px;
      white-space: nowrap;
    }

    .mobile-menu-socials {
      display: flex;
      margin-top: auto;
      gap: 8px;
    }

    .mobile-menu-socials a,
    .mobile-menu-socials img {
      display: block;
      width: 40px;
      height: 40px;
      flex: 0 0 40px;
    }

    :global(body.mobile-menu-open) {
      overflow: hidden;
      overscroll-behavior: none;
    }
  }

  @media (max-width: 767px) {


    .logo {
      width: 88px;
      height: 39px;
      flex-basis: 88px;
    }

  }

  @media (prefers-reduced-motion: reduce) {
    .ham,
    .line,
    .mobile-menu,
    .mobile-menu-backdrop {
      transition: none;
    }
  }
</style>

<script>
  const menuButton = document.querySelector('[data-menu-button]');
  const menuIcon = menuButton?.querySelector('.ham');
  const menuPanel = document.querySelector('[data-mobile-menu]');
  const menuBackdrop = document.querySelector('[data-menu-backdrop]');
  const menuLinks = menuPanel?.querySelectorAll('[data-menu-link]') ?? [];
  const backgroundElements = document.querySelectorAll(
    '.page-wrapper > main, .page-wrapper > footer, .header-inner > :not([data-menu-button])',
  );
  const mobileMedia = window.matchMedia('(max-width: 1199px)');

  if (
    menuButton instanceof HTMLButtonElement &&
    menuPanel instanceof HTMLElement &&
    menuBackdrop instanceof HTMLElement
  ) {
    const getFocusableElements = () => [
      menuButton,
      ...Array.from(menuPanel.querySelectorAll('a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])')).filter(
        (element): element is HTMLElement => element instanceof HTMLElement,
      ),
    ];

    const setMenuState = (isOpen: boolean, restoreFocus = false) => {
      menuIcon?.classList.toggle('active', isOpen);
      menuPanel.classList.toggle('is-open', isOpen);
      menuBackdrop.classList.toggle('is-open', isOpen);
      menuPanel.inert = !isOpen;
      menuPanel.setAttribute('aria-hidden', String(!isOpen));
      menuButton.setAttribute('aria-expanded', String(isOpen));
      menuButton.setAttribute('aria-label', isOpen ? 'Закрыть меню' : 'Открыть меню');
      document.body.classList.toggle('mobile-menu-open', isOpen);
      backgroundElements.forEach((element) => {
        if (element instanceof HTMLElement) element.inert = isOpen;
      });

      if (restoreFocus) menuButton.focus();
    };

    menuButton.addEventListener('click', () => {
      setMenuState(menuButton.getAttribute('aria-expanded') !== 'true');
    });

    menuBackdrop.addEventListener('click', () => setMenuState(false, true));
    menuLinks.forEach((link) => link.addEventListener('click', () => setMenuState(false)));

    document.addEventListener('keydown', (event) => {
      if (menuButton.getAttribute('aria-expanded') !== 'true') return;

      if (event.key === 'Escape') {
        event.preventDefault();
        setMenuState(false, true);
        return;
      }

      if (event.key !== 'Tab') return;

      const focusableElements = getFocusableElements();
      const firstElement = focusableElements[0];
      const lastElement = focusableElements[focusableElements.length - 1];

      if (event.shiftKey && document.activeElement === firstElement) {
        event.preventDefault();
        lastElement?.focus();
      } else if (!event.shiftKey && document.activeElement === lastElement) {
        event.preventDefault();
        firstElement?.focus();
      }
    });

    mobileMedia.addEventListener('change', (event) => {
      if (!event.matches) setMenuState(false);
    });
  }
</script>
