---
const leftNavigation = [
  { label: 'О нас', href: '#about' },
  { label: 'Наши педагоги', href: '#teachers' },
  { label: 'Фотогалерея', href: '#gallery' },
];

const rightNavigation = [
  { label: 'Стоимость', href: '#pricing' },
  { label: 'Отзывы', href: '#reviews' },
  { label: 'Контакты', href: '#contacts' },
];

const assetPath = '/images/figma-assets';
---

<header class="site-header">
  <div class="header-inner">
    <button class="mobile-menu-button" type="button" aria-label="Открыть меню">
      <img src={`${assetPath}/mobile-menu.png`} alt="" width="40" height="40" />
    </button>

    <nav class="navigation navigation-left" aria-label="Основная навигация">
      {leftNavigation.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <a class="logo" href="/" aria-label="RGballet — на главную">
      <img src={`${assetPath}/logo.png`} alt="RGballet" width="135" height="60" />
    </a>

    <nav class="navigation navigation-right" aria-label="Дополнительная навигация">
      {rightNavigation.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div class="socials" aria-label="Контакты">
      <span class="social-icon" aria-label="Telegram">
        <img src={`${assetPath}/social-telegram.png`} alt="" width="50" height="50" />
      </span>
      <a class="social-icon social-icon-bordered" href="mailto:rg-ballet@mail.ru" aria-label="Написать на электронную почту">
        <img src={`${assetPath}/social-mail-glyph.svg`} alt="" width="30" height="22" />
      </a>
      <a class="social-icon social-icon-bordered" href="tel:+79153747556" aria-label="Позвонить в RGballet">
        <img src={`${assetPath}/social-phone-glyph.svg`} alt="" width="30" height="30" />
      </a>
    </div>

    <a class="mobile-phone" href="tel:+79153747556" aria-label="Позвонить в RGballet">
      <img src={`${assetPath}/mobile-phone.png`} alt="" width="40" height="40" />
    </a>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 10;
    height: 80px;
    background: var(--color-surface-primary);
  }

  .header-inner {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .logo {
    position: absolute;
    top: 10px;
    left: 50%;
    width: 135px;
    height: 60px;
    transform: translateX(-50%);
  }

  .logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .navigation {
    position: absolute;
    top: 29px;
    display: flex;
    align-items: center;
    gap: clamp(34px, 4.167vw, 80px);
    white-space: nowrap;
  }

  .navigation-left {
    right: calc(50% + 164px);
  }

  .navigation-right {
    left: calc(50% + 165px);
  }

  .navigation a {
    font-size: 18px;
    line-height: 25px;
    text-decoration: none;
    transition: color 160ms ease;
  }

  .navigation a:hover {
    color: var(--color-accent-primary);
  }

  .socials {
    position: absolute;
    top: 15px;
    right: 40px;
    display: flex;
    gap: 16px;
  }

  .social-icon {
    display: grid;
    width: 50px;
    height: 50px;
    place-items: center;
  }

  .social-icon-bordered {
    border: 1px solid var(--color-accent-primary);
    border-radius: 50%;
  }

  .mobile-menu-button,
  .mobile-phone {
    display: none;
  }

  @media (max-width: 1500px) {
    .navigation {
      gap: 34px;
    }

    .socials {
      right: 20px;
      gap: 10px;
    }

    .social-icon {
      width: 42px;
      height: 42px;
    }

    .socials {
      top: 19px;
    }

    .social-icon img {
      max-width: 100%;
      max-height: 100%;
    }

    .social-icon-bordered img {
      width: 25px;
      height: auto;
    }
  }

  @media (max-width: 1199px) {
    .navigation,
    .socials {
      display: none;
    }

    .mobile-menu-button,
    .mobile-phone {
      position: absolute;
      top: 10px;
      display: block;
      width: 40px;
      height: 40px;
      padding: 0;
      border: 0;
      background: transparent;
    }

    .mobile-menu-button {
      left: 20px;
      cursor: pointer;
    }

    .mobile-phone {
      right: 20px;
    }
  }

  @media (max-width: 767px) {
    .site-header {
      height: 60px;
    }

    .logo {
      top: 11px;
      width: 88px;
      height: 39px;
    }
  }
</style>
