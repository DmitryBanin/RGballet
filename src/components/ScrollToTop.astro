---
const assetPath = `${import.meta.env.BASE_URL}/images`;
---

<button class="scroll-to-top" type="button" aria-label="Вернуться наверх" data-scroll-to-top hidden>
  <img src={`${assetPath}/arraw_up.svg`} alt="" width="70" height="70" />
</button>

<style>
  .scroll-to-top {
    position: fixed;
    right: max(20px, env(safe-area-inset-right));
    bottom: max(20px, env(safe-area-inset-bottom));
    z-index: 20;
    width: 70px;
    height: 70px;
    padding: 0;
    background: transparent;
    border: 0;
    cursor: pointer;
  }

  .scroll-to-top img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .scroll-to-top:focus-visible {
    outline: 2px solid var(--color-accent-primary);
    outline-offset: 4px;
  }

  :global(body.mobile-menu-open) .scroll-to-top {
    display: none;
  }

  @media (min-width: 1200px) {
    .scroll-to-top {
      display: none;
    }
  }
</style>

<script>
  const scrollToTopButton = document.querySelector('[data-scroll-to-top]');
  const mobileMedia = window.matchMedia('(max-width: 1199px)');
  const reducedMotionMedia = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (scrollToTopButton instanceof HTMLButtonElement) {
    const updateButtonVisibility = () => {
      scrollToTopButton.hidden = !mobileMedia.matches || window.scrollY <= 500;
    };

    scrollToTopButton.addEventListener('click', () => {
      window.scrollTo({
        top: 0,
        behavior: reducedMotionMedia.matches ? 'auto' : 'smooth',
      });
    });

    window.addEventListener('scroll', updateButtonVisibility, { passive: true });
    mobileMedia.addEventListener('change', updateButtonVisibility);
    updateButtonVisibility();
  }
</script>
