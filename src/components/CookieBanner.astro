---
const privacyPolicyPath = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/privacy-policy/`;
---

<section class="cookie-banner" aria-label="Настройки cookie" data-cookie-banner hidden>
  <div class="cookie-copy">
    <p>Мы используем файлы cookie и Яндекс Метрику для анализа посещаемости сайта и оценки эффективности рекламы.</p>
    <p>Вы можете разрешить использование аналитических cookie или оставить только необходимые для работы сайта.</p>
    <p>Подробнее — в <a href={privacyPolicyPath}>Политике в отношении обработки персональных данных</a>.</p>
  </div>

  <div class="cookie-actions">
    <button type="button" class="cookie-accept" data-cookie-choice="all">Принять</button>
    <button type="button" class="cookie-necessary" data-cookie-choice="necessary">Только необходимые</button>
  </div>
</section>

<script is:inline>
  const banner = document.querySelector('[data-cookie-banner]');
  const COOKIE_NAME = 'rgballet_cookie_consent';
  const LEGACY_STORAGE_KEY = 'rgballet-cookie-consent-v1';
  // При изменении текста согласия обновить версию, например на '2.0'.
  const CONSENT_VERSION = '1.0';

  function isValidConsentData(consentData) {
    if (
      !consentData ||
      typeof consentData !== 'object' ||
      Array.isArray(consentData) ||
      Object.keys(consentData).length !== 3 ||
      (consentData.choice !== 'all' && consentData.choice !== 'necessary') ||
      consentData.consentVersion !== CONSENT_VERSION ||
      typeof consentData.consentDate !== 'string'
    ) {
      return false;
    }

    const consentDate = new Date(consentData.consentDate);
    return !Number.isNaN(consentDate.getTime()) && consentDate.toISOString() === consentData.consentDate;
  }

  function keepConsentFields(savedData) {
    return {
      choice: savedData?.choice,
      consentVersion: savedData?.consentVersion,
      consentDate: savedData?.consentDate,
    };
  }

  function getCookieValue() {
    const prefix = `${COOKIE_NAME}=`;
    const cookie = document.cookie.split(';').find((part) => part.trim().startsWith(prefix));
    return cookie === undefined ? null : cookie.trim().slice(prefix.length);
  }

  function readCookieConsent() {
    const cookieValue = getCookieValue();
    if (cookieValue === null) return { exists: false, consentData: null };

    try {
      const consentData = JSON.parse(decodeURIComponent(cookieValue));
      if (isValidConsentData(consentData)) return { exists: true, consentData };

      // Ранее выданную cookie с четвёртым полем заменяем без повторного запроса согласия.
      if (consentData && typeof consentData === 'object' && Object.keys(consentData).length === 4) {
        const migratedData = keepConsentFields(consentData);
        if (isValidConsentData(migratedData) && writeCookieConsent(migratedData)) {
          return { exists: true, consentData: migratedData };
        }
      }
    } catch {
      // Повреждённую cookie не считаем действительным согласием.
    }

    return { exists: true, consentData: null };
  }

  function writeCookieConsent(consentData) {
    try {
      const value = encodeURIComponent(JSON.stringify(consentData));
      document.cookie = `${COOKIE_NAME}=${value}; Path=/; SameSite=Lax; Secure; Max-Age=31536000`;
      const savedValue = getCookieValue();
      if (savedValue === null) return false;
      const savedConsent = JSON.parse(decodeURIComponent(savedValue));
      return isValidConsentData(savedConsent) &&
        savedConsent.choice === consentData.choice &&
        savedConsent.consentDate === consentData.consentDate;
    } catch {
      return false;
    }
  }

  function migrateLegacyConsent() {
    let savedData;
    try {
      savedData = window.localStorage.getItem(LEGACY_STORAGE_KEY);
    } catch {
      return null;
    }

    if (savedData === null) return null;

    let legacyData;
    try {
      legacyData = JSON.parse(savedData);
    } catch {
      legacyData = null;
    }

    const consentData = keepConsentFields(legacyData);

    if (!isValidConsentData(consentData)) {
      try {
        window.localStorage.removeItem(LEGACY_STORAGE_KEY);
      } catch {
        // Доступ к старому хранилищу может быть ограничен браузером.
      }
      return null;
    }

    if (!writeCookieConsent(consentData)) return null;

    try {
      window.localStorage.removeItem(LEGACY_STORAGE_KEY);
    } catch {
      // Cookie уже сохранена; старая запись больше не используется.
    }
    return consentData;
  }

  function enableYandexMetrica() {
    // TODO: здесь добавить ID и загрузку Яндекс Метрики. Функция вызывается только при choice === 'all'.
  }

  function saveCookieConsent(choice) {
    if (choice !== 'all' && choice !== 'necessary') return null;

    const consentData = {
      choice,
      consentVersion: CONSENT_VERSION,
      consentDate: new Date().toISOString(),
    };

    if (!writeCookieConsent(consentData)) return null;

    return consentData;
  }

  if (banner instanceof HTMLElement) {
    const cookieConsent = readCookieConsent();
    const savedConsent = cookieConsent.exists ? cookieConsent.consentData : migrateLegacyConsent();
    banner.hidden = savedConsent !== null;

    if (savedConsent?.choice === 'all') enableYandexMetrica();

    banner.querySelectorAll('[data-cookie-choice]').forEach((button) => {
      if (!(button instanceof HTMLButtonElement)) return;

      button.addEventListener('click', () => {
        const consentData = saveCookieConsent(button.dataset.cookieChoice);
        if (!consentData) return;

        banner.hidden = true;
        if (consentData.choice === 'all') enableYandexMetrica();
      });
    });
  }
</script>

<style>
  .cookie-banner {
    position: fixed;
    z-index: 90;
    bottom: max(20px, env(safe-area-inset-bottom));
    left: 50%;
    display: flex;
    width: min(840px, calc(100% - 40px));
    min-height: 200px;
    max-height: calc(100dvh - 40px);
    padding: 32px;
    align-items: center;
    gap: 30px;
    overflow-y: auto;
    background: var(--color-surface-primary);
    border: 1px solid var(--color-accent-primary-30);
    border-radius: 24px;
    box-shadow: 0 12px 44px rgb(35 35 35 / 16%);
    overscroll-behavior: contain;
    transform: translateX(-50%);
  }

  .cookie-banner[hidden] {
    display: none;
  }

  .cookie-copy {
    min-width: 0;
    flex: 1;
  }

  .cookie-copy p {
    margin: 0;
    font-size: 15px;
    line-height: 1.5;
  }

  .cookie-copy p + p {
    margin-top: 10px;
  }

  .cookie-copy a {
    color: var(--color-accent-primary);
    text-underline-offset: 3px;
  }

  .cookie-actions {
    display: flex;
    width: 220px;
    flex: 0 0 220px;
    flex-direction: column;
    gap: 10px;
  }

  .cookie-actions button {
    min-height: 46px;
    padding: 10px 16px;
    border-radius: 30px;
    cursor: pointer;
    font-size: 15px;
    font-weight: 500;
    line-height: 1.4;
  }

  .cookie-accept {
    color: var(--color-surface-primary);
    background: linear-gradient(180deg, var(--color-button-gradient-start), var(--color-button-gradient-end));
    border: 1px solid var(--color-button-border);
  }

  .cookie-necessary {
    color: var(--color-text-primary);
    background: var(--color-surface-primary);
    border: 1px solid var(--color-accent-primary);
  }

  @media (width < 768px) {
    .cookie-banner {
      flex-direction: column;
      align-items: stretch;
      border-radius: 20px;
    }

    .cookie-copy p {
      font-size: 14px;
    }

    .cookie-actions {
      width: 100%;
      flex: 0 0 auto;
    }
  }
</style>
