---
import GradientButton from './GradientButton.astro';

const { title, buttonLabel, titleId } = Astro.props;
---

<section class="banner" aria-labelledby={titleId}>
  <div class="banner-content">
    <h2 id={titleId}>{title}</h2>
    <GradientButton label={buttonLabel} opensForm={true} />
  </div>
</section>

<style>
  .banner {
    display: flex;
    margin-top: 110px;
    padding: 48px var(--page-gutter);
    align-items: flex-start;
    justify-content: center;
    background: var(--color-accent-secondary-20);
  }

  .banner-content {
    display: flex;
    width: min(100%, 1155px);
    flex-direction: column;
    align-items: center;
    gap: 45px;
  }

  h2 {
    margin: 0;
    font-family: 'Corvetta', 'Cormorant Garamond', serif;
    font-size: clamp(30px, calc(-13.98px + 5.206vw), 50px);
    font-weight: 400;
    line-height: clamp(70px, calc(-39.96px + 13.015vw), 120px);
    text-align: center;
  }

  #invitation-title {
    width: min(100%, 1155px);
  }

  #recruitment-title {
    width: min(100%, 1080px);
  }

  @media (max-width: 767px) {
    h2 {
      max-width: 100%;
      font-size: clamp(26px, calc(20.462px + 1.538vw), 50px);
      line-height: normal;
    }
  }
  
</style>
