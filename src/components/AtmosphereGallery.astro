---
import { getGalleryPhotos } from '../config/galleryPhotos.js';

const assetPath = `${import.meta.env.BASE_URL}/images/atmosphere`;
const assetPathArrow = `${import.meta.env.BASE_URL}/images`;

const photos = await getGalleryPhotos('atmosphere', {
  'atmosphere-1.webp': 'Сольное выступление ученицы RG-ballet',
  'atmosphere-2.webp': 'Ученицы RG-ballet после занятия',
  'atmosphere-3.webp': 'Сценический номер RG-ballet',
  'atmosphere-4.webp': 'Выступление коллектива RG-ballet',
  'atmosphere-5.webp': 'Ученицы RG-ballet с наградами',
  'atmosphere-6.webp': 'Ученицы RG-ballet перед выступлением',
}, 'Атмосфера RG-ballet');
---

<section class="atmosphere" aria-labelledby="atmosphere-title" data-atmosphere-gallery>
  <header class="atmosphere-header">
    <h2 id="atmosphere-title">Погрузитесь в атмосферу вдохновения!</h2>
    <p>
      <strong>Присоединяйтесь к RG-ballet</strong> и окунитесь в мир творчества и танца, где ты раскроешь свой
      потенциал, а также обретёшь новых друзей. <strong>У нас тёплая атмосфера и индивидуальный подход к каждому клиенту.</strong>
    </p>
  </header>

  <div class="atmosphere-grid">
    {photos.slice(0, 6).map((photo) => (
      <img src={`${assetPath}/${encodeURIComponent(photo.image)}`} alt={photo.alt} width="290" height="340" loading="lazy" data-atmosphere-tile />
    ))}
  </div>

  <div class="atmosphere-slider" aria-live="polite">
    {photos.map((photo, index) => (
      <img
        class:list={['atmosphere-slide', { 'is-active': index === 0 }]}
        src={`${assetPath}/${encodeURIComponent(photo.image)}`}
        alt={photo.alt}
        aria-hidden={index === 0 ? 'false' : 'true'}
        width="320"
        height="437"
        loading="lazy"
        data-atmosphere-slide
      />
    ))}
  </div>

  <div class="atmosphere-navigation">
    <div class="atmosphere-position">
      <div class="atmosphere-dots" aria-label="Выбор фотографии">
        {photos.slice(0, 5).map((_, index) => (
          <button
            class:list={['atmosphere-dot', { 'is-active': index === 0 }]}
            type="button"
            aria-label={`Фотография ${index + 1} из ${photos.length}`}
            aria-current={index === 0 ? 'true' : undefined}
            data-atmosphere-dot={index}
          />
        ))}
      </div>
      <span class="atmosphere-counter" aria-live="polite" data-atmosphere-counter>1 из {photos.length}</span>
    </div>
    <div class="atmosphere-arrows" aria-label="Управление галереей">
      <button class="atmosphere-arrow prev" type="button" aria-label="Предыдущая фотография" data-atmosphere-prev>
        <img src={`${assetPathArrow}/arrow.svg`} alt="" width="50" height="50" />
      </button>
      <button class="atmosphere-arrow next" type="button" aria-label="Следующая фотография" data-atmosphere-next>
        <img src={`${assetPathArrow}/arrow.svg`} alt="" width="50" height="50" />
      </button>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-atmosphere-gallery]').forEach((gallery) => {
    const slides = [...gallery.querySelectorAll<HTMLImageElement>('[data-atmosphere-slide]')];
    const dots = [...gallery.querySelectorAll<HTMLButtonElement>('[data-atmosphere-dot]')];
    const tiles = [...gallery.querySelectorAll<HTMLImageElement>('[data-atmosphere-tile]')];
    const previousButton = gallery.querySelector<HTMLButtonElement>('[data-atmosphere-prev]');
    const nextButton = gallery.querySelector<HTMLButtonElement>('[data-atmosphere-next]');
    const counter = gallery.querySelector<HTMLElement>('[data-atmosphere-counter]');
    const slider = gallery.querySelector<HTMLElement>('.atmosphere-slider');
    const images = slides.map((slide) => ({ src: slide.src, alt: slide.alt }));
    let current = 0;
    let swipeStartX = 0;
    let swipeStartY = 0;

    const update = (nextIndex: number) => {
      current = Math.min(Math.max(nextIndex, 0), slides.length - 1);
      slides.forEach((slide, index) => {
        const active = index === current;
        slide.classList.toggle('is-active', active);
        slide.setAttribute('aria-hidden', String(!active));
      });
      const firstDot = Math.min(Math.max(current - Math.floor(dots.length / 2), 0), slides.length - dots.length);
      dots.forEach((dot, index) => {
        const photoIndex = firstDot + index;
        const active = photoIndex === current;
        dot.dataset.atmosphereDot = String(photoIndex);
        dot.setAttribute('aria-label', `Фотография ${photoIndex + 1} из ${slides.length}`);
        dot.classList.toggle('is-active', active);
        active ? dot.setAttribute('aria-current', 'true') : dot.removeAttribute('aria-current');
      });
      if (counter) counter.textContent = `${current + 1} из ${slides.length}`;
      tiles.forEach((tile, index) => {
        const image = images[(index + current) % images.length];
        if (!image) return;

        tile.src = image.src;
        tile.alt = image.alt;
      });
      if (previousButton) previousButton.disabled = current === 0;
      if (nextButton) nextButton.disabled = current === slides.length - 1;
    };

    previousButton?.addEventListener('click', () => update(current - 1));
    nextButton?.addEventListener('click', () => update(current + 1));
    dots.forEach((dot) => dot.addEventListener('click', () => update(Number(dot.dataset.atmosphereDot))));
    gallery.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
      if (!(event.target instanceof HTMLElement) || !event.target.closest('.atmosphere-navigation')) return;

      event.preventDefault();
      update(current + (event.key === 'ArrowRight' ? 1 : -1));
    });
    slider?.addEventListener('pointerdown', (event) => {
      if (event.pointerType === 'mouse') return;

      swipeStartX = event.clientX;
      swipeStartY = event.clientY;
      (event.currentTarget as HTMLElement).setPointerCapture(event.pointerId);
    });

    slider?.addEventListener('pointerup', (event) => {
      if (event.pointerType === 'mouse') return;

      const distanceX = event.clientX - swipeStartX;
      const distanceY = event.clientY - swipeStartY;

      if (Math.abs(distanceX) >= 50 && Math.abs(distanceX) > Math.abs(distanceY)) {
        update(current + (distanceX < 0 ? 1 : -1));
      }
    });

    update(0);
  });
</script>

<style>
  .atmosphere {
    width: min(100%, var(--container-max-width));
    min-height: 578px;
    margin: var(--section-space) auto 0;
  }

  .atmosphere-header {
    display: flex;
    min-height: 198px;
    flex-direction: column;
    align-items: center;
    gap: 30px;
    text-align: center;
  }

  h2,
  p {
    margin: 0;
  }

  h2 {
    width: 100%;
    color: var(--color-accent-primary);
    /* cspell:ignore Corvetta */
    font-family: 'Corvetta', 'Cormorant Garamond', serif;
    font-size: var(--section-title-compact);
    font-weight: 400;
    line-height: clamp(80px, 5.208vw, 100px);
  }

  .atmosphere-header p {
    width: min(100%, 1551px);
    font-size: 24px;
    line-height: 34px;
  }

  .atmosphere-header strong {
    font-weight: 600;
  }

  .atmosphere-grid {
    display: grid;
    height: 340px;
    margin-top: 40px;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 20px;
  }

  .atmosphere-grid img {
    width: 100%;
    height: 340px;
    border-radius: 30px;
    object-fit: cover;
  }

  .atmosphere-navigation {
    position: relative;
    display: flex;
    min-height: 50px;
    margin-top: 20px;
    align-items: center;
    justify-content: center;
  }

  .atmosphere-position,
  .atmosphere-dots,
  .atmosphere-arrows {
    display: flex;
    align-items: center;
  }

  .atmosphere-position {
    gap: 16px;
  }

  .atmosphere-counter {
    font-size: 16px;
    line-height: 24px;
    white-space: nowrap;
  }

  .atmosphere-dots {
    height: 24px;
    justify-content: center;
    gap: 10px;
  }

  .atmosphere-dot {
    width: 24px;
    height: 24px;
    padding: 0;
    background: transparent;
    border: 2px solid var(--color-accent-primary);
    border-radius: 50%;
    cursor: pointer;
  }

  .atmosphere-dot.is-active {
    background: var(--color-accent-primary);
  }

  .atmosphere-arrows {
    position: absolute;
    right: 0;
    height: 50px;
    gap: 29px;
  }

  .atmosphere-arrow {
    display: grid;
    width: 50px;
    height: 50px;
    padding: 0;
    place-items: center;
    background: transparent;
    border: 0;
    cursor: pointer;
  }

  .atmosphere-arrow img {
    width: 100%;
    height: 100%;
  }

  .atmosphere-arrow.prev img {
    transform: scaleX(-1);
  }

  .atmosphere-arrow:disabled {
    opacity: 0.5;
    cursor: default;
  }

  .atmosphere-slider {
    display: none;
  }

  @media (width < 1920px) {
    .atmosphere {
      width: auto;
      margin-inline: var(--page-gutter);
    }
  }

  @media (768px <= width < 1200px) {
    .atmosphere {
      min-height: auto;
      margin-top: var(--section-space);
    }

    .atmosphere-header {
      min-height: 0;
    }

    h2 {
      line-height: 80px;
    }

    .atmosphere-header p {
      font-size: 20px;
      line-height: 30px;
    }

    .atmosphere-grid {
      height: auto;
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .atmosphere-grid img {
      height: 320px;
    }

    .atmosphere-navigation {
      min-height: 30px;
    }

    .atmosphere-position {
      gap: 10px;
    }

    .atmosphere-counter {
      font-size: 14px;
      line-height: 16px;
    }

    .atmosphere-dots {
      height: 16px;
      gap: 6px;
    }

    .atmosphere-dot {
      width: 16px;
      height: 16px;
    }

    .atmosphere-arrows,
    .atmosphere-arrow {
      height: 30px;
    }

    .atmosphere-arrows {
      gap: 16px;
    }

    .atmosphere-arrow {
      width: 30px;
    }
  }

  @media (width < 768px) {
    .atmosphere {
      width: auto;
      min-height: 856px;
      margin: var(--section-space) 20px 0;
    }

    .atmosphere-header {
      min-height: 320px;
      gap: 30px;
    }

    h2 {
      height: 180px;
      max-width: 100%;
      font-size: clamp(30px, 8vw, 32px);
      line-height: clamp(50px, 15vw, 60px);
    }

    .atmosphere-header p {
      width: 320px;
      max-width: 100%;
      font-size: var(--mobile-copy-size);
      line-height: var(--mobile-copy-line);
    }

    .atmosphere-grid {
      display: none;
    }

    .atmosphere-slider {
      position: relative;
      display: block;
      width: 100%;
      height: 437px;
      margin-top: 64px;
      overflow: hidden;
      border-radius: 30px;
      background: var(--color-photo-placeholder);
      touch-action: pan-y;
      user-select: none;
    }

    .atmosphere-slide {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      opacity: 0;
      object-fit: cover;
      transition: opacity 200ms ease;
    }

    .atmosphere-slide.is-active {
      z-index: 1;
      opacity: 1;
    }

    .atmosphere-navigation {
      min-height: 16px;
      margin-top: 19px;
    }

    .atmosphere-position {
      gap: 10px;
    }

    .atmosphere-counter {
      font-size: 14px;
      line-height: 16px;
    }

    .atmosphere-dots {
      height: 16px;
      gap: 6px;
    }

    .atmosphere-dot {
      width: 16px;
      height: 16px;
    }

    .atmosphere-arrows {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .atmosphere-slide {
      transition: none;
    }
  }
</style>
