---
import GradientButton from './GradientButton.astro';

const assetPath = `${import.meta.env.BASE_URL}/images`;
const consentPath = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/personal-data-consent/`;
const privacyPolicyPath = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/privacy-policy/`;
---

    <section
      class="question-form"
      aria-labelledby="question-title"
      style={`--form-checkbox-image: url("${assetPath}/form-checkbox.svg")`}
    >
      <div class="question-heading">
        <h2 id="question-title">Остались вопросы?</h2>
        <p>Мы с радостью ответим!</p>
      </div>

      <form>
        <label class="form-field">
          <span class="visually-hidden">Ваше имя</span>
          <input
            type="text"
            name="name"
            placeholder="Ваше имя"
            autocomplete="name"
            title="Используйте только буквы, пробелы и дефис"
            required
          />
        </label>
        <label class="form-field">
          <span class="visually-hidden">Телефон</span>
          <input
            type="tel"
            name="phone"
            placeholder="+7 000 000-00-00"
            autocomplete="tel"
            inputmode="tel"
            pattern="\+7 [0-9]{3} [0-9]{3}-[0-9]{2}-[0-9]{2}"
            title="Введите номер телефона цифрами в формате +7 000 000-00-00"
            required
          />
        </label>
        <label class="form-field">
          <span class="visually-hidden">Комментарий</span>
          <textarea name="comment" placeholder="Комментарий" rows="3" maxlength="300"></textarea>
        </label>
        <label class="form-consent">
          <input type="checkbox" name="consent" required />
          <span>
            Я даю <a href={consentPath}>согласие на обработку персональных данных</a> и подтверждаю, что ознакомлен(а) с
            <a href={privacyPolicyPath}>Политикой обработки персональных данных</a>.
          </span>
        </label>
        <div class="form-action">
          <GradientButton label="Отправить" fullWidth={true} />
          <p class="demo-status" role="status" aria-live="polite" data-form-demo-status hidden>
            Спасибо! Тестовый режим — данные не отправлены.
          </p>
        </div>
      </form>
    </section>

<script>
  import { setupDemoFormSubmit } from '../js/demoFormSubmit.js';
  import { setupNameInput } from '../js/nameInput.js';
  import { setupPhoneMask } from '../js/phoneMask.js';

  setupNameInput(document.querySelector('.question-form input[name="name"]'));
  setupPhoneMask(document.querySelector('.question-form input[name="phone"]'));
  setupDemoFormSubmit(
    document.querySelector('.question-form form'),
    document.querySelector('.question-form .form-action button'),
  );
</script>
